+  // Aerium: no share-target API exists on the desktop web platform, so this
+  // copies to the clipboard instead of opening a share sheet the way the
+  // Android build's equivalent row does. The label swap is the only
+  // confirmation available without a toast host mounted in this page - see
+  // theme.sh's Android equivalent for why a real toast wasn't used here
+  // either: chrome://settings mounts no <cr-toast-manager>, unlike
+  // chrome://downloads or chrome://extensions, so getToastManager() would
+  // assert rather than show anything.
+  protected async onShareAeriumClick_() {
+    await navigator.clipboard.writeText(ABOUT_PAGE_SHARE_TEXT);
+    this.shareRowLabel_ = loadTimeData.getString('aboutShareAeriumCopied');
+    setTimeout(() => {
+      this.shareRowLabel_ = loadTimeData.getString('aboutShareAerium');
+    }, 2000);
+  }
+
   protected onRelaunchClick_() {
     this.performRestart(RestartType.RELAUNCH);
   }

