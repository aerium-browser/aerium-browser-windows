+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Aerium: a jar is a tab with a storage partition to itself.
+//
+// Site isolation, storage partitioning and the ephemeral-sites list all answer
+// "keep this site away from other sites". None of them answer "keep this site
+// away from itself" - a second account on a site you are already signed in to,
+// or a link you would rather not hand to the profile that knows who you are.
+// Firefox solves that with containers. This is the same idea with a shorter
+// lifetime: the jar is created when the tab is, and is emptied when it closes.
+//
+// The mechanism is SiteInstance::CreateForFixedStoragePartition, whose whole
+// purpose is a partition that survives navigation within a frame tree. Every
+// jar is created with in_memory=true, which is the load-bearing property here:
+// the partition is never written to disk at all, so "cleared when you close
+// the tab" is a statement about memory rather than a promise to delete
+// something. There is nothing on disk to fail to delete.
+//
+// What a jar is NOT: it is not Incognito. History, downloads and the
+// omnibox's memory belong to the profile and are not partitioned, so an
+// Aerogel tab still records where it went. It separates identity, not traces.
+// Incognito remains the answer to "leave nothing behind locally", and the
+// menu string says so.
+
+#include "chrome/browser/ui/aerium/aerogel.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/callback_helpers.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/lifetime/browser_shutdown.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_group_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/tab_groups/tab_group_color.h"
+#include "components/tab_groups/tab_group_id.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+#include "components/tabs/public/tab_group.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "content/public/common/referrer.h"
+#include "third_party/blink/public/common/storage_key/storage_key.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+
+namespace aerogel {
+namespace {
+
+// StoragePartitionConfig::Create requires a non-empty [a-z]* domain, so this
+// is not a display string and cannot become one.
+constexpr char kPartitionDomain[] = "aerogel";
+
+// Each jar needs a name no other jar has worn. A counter that only ever goes up
+// is enough, and it does not need to survive a restart: the partitions it names
+// are in-memory, so a name from a previous run refers to nothing.
+std::string NextPartitionName() {
+  static int next = 0;
+  return base::NumberToString(++next);
+}
+
+// Rides along on the tab, holds the tab's partition, and empties it when the
+// tab goes away. Being WebContentsUserData is also how IsJarTab answers - the
+// presence of this object IS what makes a tab a jar, so the two can never
+// disagree.
+class JarHelper : public content::WebContentsUserData<JarHelper>,
+                  public content::WebContentsObserver {
+ public:
+  JarHelper(const JarHelper&) = delete;
+  JarHelper& operator=(const JarHelper&) = delete;
+  ~JarHelper() override;
+
+  // content::WebContentsObserver:
+  void WebContentsDestroyed() override;
+
+ private:
+  friend class content::WebContentsUserData<JarHelper>;
+
+  JarHelper(content::WebContents* contents,
+            content::StoragePartitionConfig config);
+
+  // Stored rather than re-derived from the SiteInstance. By the time the tab is
+  // being torn down its SiteInstance is not somewhere to be asking questions,
+  // and this is exactly when the config is needed.
+  const content::StoragePartitionConfig config_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+JarHelper::JarHelper(content::WebContents* contents,
+                     content::StoragePartitionConfig config)
+    : content::WebContentsUserData<JarHelper>(*contents),
+      content::WebContentsObserver(contents),
+      config_(std::move(config)) {}
+
+JarHelper::~JarHelper() = default;
+
+void JarHelper::WebContentsDestroyed() {
+  // Nothing in this partition ever reached disk, so a clear that does not run
+  // costs memory and nothing else. At shutdown that memory is going away
+  // anyway, and asking a profile that is already tearing itself down for a
+  // storage partition is the more dangerous half of the trade.
+  if (browser_shutdown::HasShutdownStarted()) {
+    return;
+  }
+
+  content::BrowserContext* const context = web_contents()->GetBrowserContext();
+  if (!context) {
+    return;
+  }
+
+  // can_create=false: if the partition was never materialised there is nothing
+  // to empty, and creating one here just to clear it would be absurd.
+  content::StoragePartition* const partition =
+      context->GetStoragePartition(config_, /*can_create=*/false);
+  if (!partition) {
+    return;
+  }
+
+  // A default-constructed StorageKey has an opaque origin, which ClearData
+  // documents as meaning "all data in this partition" rather than one origin's.
+  partition->ClearData(content::StoragePartition::REMOVE_DATA_MASK_ALL,
+                       blink::StorageKey(), base::Time(), base::Time::Max(),
+                       base::DoNothing());
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(JarHelper);
+
+// Aerogel tabs go in a group so the tab strip says which tabs are jars without
+// a new piece of UI existing to say it. One group per window, reused, because
+// two jars are still two separate jars - the group is a label, not a boundary.
+void PlaceInAerogelGroup(Browser* browser, int index) {
+  TabStripModel* const model = browser->tab_strip_model();
+  TabGroupModel* const groups = model->group_model();
+  if (!groups) {
+    return;
+  }
+
+  const std::u16string title =
+      l10n_util::GetStringUTF16(IDS_AERIUM_AEROGEL_GROUP_TITLE);
+  for (const tab_groups::TabGroupId& id : groups->ListTabGroups()) {
+    TabGroup* const group = groups->GetTabGroup(id);
+    if (group && group->visual_data()->title() == title) {
+      model->AddToExistingGroup({index}, id);
+      return;
+    }
+  }
+
+  const tab_groups::TabGroupId id = model->AddToNewGroup({index});
+  TabGroup* const group = groups->GetTabGroup(id);
+  if (group) {
+    group->SetVisualData(
+        tab_groups::TabGroupVisualData(
+            title, tab_groups::TabGroupColorId::kCyan, /*is_collapsed=*/false),
+        /*is_customized=*/true);
+  }
+}
+
+}  // namespace
+
+bool IsJarTab(const content::WebContents* contents) {
+  return contents && JarHelper::FromWebContents(contents) != nullptr;
+}
+
+void OpenInNewJar(Browser* browser, const GURL& url) {
+  if (!browser || !url.is_valid()) {
+    return;
+  }
+  Profile* const profile = browser->GetProfile();
+
+  // in_memory=true is the whole feature. Note that for an off-the-record
+  // profile StoragePartitionConfig::Create forces it on regardless, which is
+  // the behaviour we want anyway: an Aerogel tab opened from Incognito is
+  // in-memory twice over rather than accidentally persistent.
+  const content::StoragePartitionConfig config =
+      content::StoragePartitionConfig::Create(profile, kPartitionDomain,
+                                              NextPartitionName(),
+                                              /*in_memory=*/true);
+
+  // CreateForFixedStoragePartition, rather than plain Create, is what keeps the
+  // tab in this partition as it navigates. Without "fixed" the first
+  // cross-site navigation would land back in the profile's own partition and
+  // the jar would quietly stop being a jar.
+  scoped_refptr<content::SiteInstance> site_instance =
+      content::SiteInstance::CreateForFixedStoragePartition(profile, url,
+                                                            config);
+
+  content::WebContents::CreateParams params(profile, std::move(site_instance));
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(params);
+  content::WebContents* const raw_contents = contents.get();
+
+  // Attached before the tab strip sees it, so that anything observing tab
+  // insertion - session save, most of all - already gets a truthful answer from
+  // IsJarTab. Attaching afterwards would leave a window in which this tab looks
+  // ordinary, and the session file is written from inside that window.
+  JarHelper::CreateForWebContents(raw_contents, config);
+
+  raw_contents->GetController().LoadURL(url, content::Referrer(),
+                                        ui::PAGE_TRANSITION_TYPED,
+                                        std::string());
+
+  TabStripModel* const model = browser->tab_strip_model();
+  model->AppendWebContents(std::move(contents), /*foreground=*/true);
+
+  const int index = model->GetIndexOfWebContents(raw_contents);
+  if (index != TabStripModel::kNoTab) {
+    PlaceInAerogelGroup(browser, index);
+  }
+}
+
+void OpenNewJarTab(Browser* browser) {
+  OpenInNewJar(browser, GURL(chrome::kChromeUINewTabURL));
+}
+
+}  // namespace aerogel
