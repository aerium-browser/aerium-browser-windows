+#ifndef CHROME_BROWSER_UI_AERIUM_AEROGEL_H_
+#define CHROME_BROWSER_UI_AERIUM_AEROGEL_H_
+
+class Browser;
+class GURL;
+
+namespace content {
+class WebContents;
+}
+
+// Aerium: per-tab storage jars. See aerogel.cc for what a jar is and why.
+namespace aerogel {
+
+// True if `contents` is an Aerogel tab: one whose cookies and storage live in
+// a private in-memory partition instead of the profile's own.
+//
+// Callers outside this file are the places that must not treat a jar like an
+// ordinary tab - session save and the reopen-closed-tab list.
+bool IsJarTab(const content::WebContents* contents);
+
+// Opens `url` in a new foreground tab of `browser` with a storage partition of
+// its own, and puts that tab in the window's Aerogel group so it does not look
+// like an ordinary tab.
+void OpenInNewJar(Browser* browser, const GURL& url);
+
+// OpenInNewJar on the new-tab page. Exists so that a menu entry point does not
+// have to name a URL, and so that which URL that is stays in one place.
+void OpenNewJarTab(Browser* browser);
+
+}  // namespace aerogel
+
+#endif  // CHROME_BROWSER_UI_AERIUM_AEROGEL_H_
