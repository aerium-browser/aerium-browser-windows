# Two more of the same shape as the four defaults below: shipped, wired to a
# real consumer, switched off pending a Finch rollout that never reaches a
# build that never asks the variations server.
#
# kMemorySaverModeRenderTuning is extra render-side tuning (available memory
# threshold 740MB, upstream's own default param, left untouched) that only
# does anything once Memory Saver mode - already turned on by the pref change
# below - is actually active. Enabling the mode without this is turning on
# three quarters of it.
#
# kBatterySaverModeAlignWakeUps coalesces heavy timer wake-ups while Battery
# Saver is requesting them, which only matters because Battery Saver has a
# real activation path here: the pref change below sets it to kEnabledOnBattery
# rather than upstream's kEnabledBelowThreshold, so it turns on as soon as the
# device reports running on battery, not only once charge drops low. Desktop
# only - Battery Saver's own UI and activation logic in
# performance_manager/user_tuning is !BUILDFLAG(IS_ANDROID)-gated, so there is
# no confirmed trigger path for this on the Android build; enabling it there
# without one would be a feature nothing reads, the same anti-pattern
# aerium-runtime-efficiency.patch's header rejects kDiscardOnCommitLimit for.
--- a/components/performance_manager/user_tuning/prefs.cc
+++ b/components/performance_manager/user_tuning/prefs.cc
@@ -32,13 +32,13 @@
       kMemorySaverModeTimeBeforeDiscardInMinutes,
       kDefaultMemorySaverModeTimeBeforeDiscardInMinutes);
   registry->RegisterIntegerPref(
-      kMemorySaverModeState, static_cast<int>(MemorySaverModeState::kDisabled));
+      kMemorySaverModeState, static_cast<int>(MemorySaverModeState::kEnabled));
   registry->RegisterIntegerPref(
       kMemorySaverModeAggressiveness,
       static_cast<int>(MemorySaverModeAggressiveness::kMedium));
   registry->RegisterIntegerPref(
       kBatterySaverModeState,
-      static_cast<int>(BatterySaverModeState::kEnabledBelowThreshold));
+      static_cast<int>(BatterySaverModeState::kEnabledOnBattery));
   registry->RegisterTimePref(kLastBatteryUseTimestamp, base::Time());
   registry->RegisterBooleanPref(kDiscardRingTreatmentEnabled, true);
   registry->RegisterBooleanPref(kPerformanceInterventionNotificationEnabled,
--- a/chrome/browser/preloading/preloading_prefs.cc
+++ b/chrome/browser/preloading/preloading_prefs.cc
@@ -16,7 +16,7 @@
