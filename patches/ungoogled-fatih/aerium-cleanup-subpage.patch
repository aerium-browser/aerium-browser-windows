+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-aerium-cleanup-page' is the subpage behind the "Automatic cleanup"
+ * row on Privacy and security. It holds the three blocks that decide what
+ * Aerium deletes on its own: the delete-on-exit toggle with its eight data
+ * types and its never-delete list, the delete-when-the-last-tab-closes toggle
+ * with its delay and cache options, and the per-site rules table.
+ *
+ * They used to sit inline on Privacy and security, one after another, which
+ * put five switches, a number field and a table between the page title and
+ * "Delete browsing data". Behind one row they are a thing you go and set up,
+ * which is what they are.
+ *
+ * The three elements are unchanged and still own their own prefs; this page
+ * only groups them and gives them a title and a back arrow. It composes
+ * PrefsMixin because it forwards prefs to all three, and SettingsViewMixin
+ * because every cr-view-manager view needs the routePath it supplies.
+ */
+import '../settings_page/settings_subpage.js';
+import '../settings_shared.css.js';
+import './clear_on_exit.js';
+import './ephemeral_sites.js';
+import './site_rules.js';
+
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {SettingsViewMixin} from '../settings_page/settings_view_mixin.js';
+
+import {getTemplate} from './aerium_cleanup_page.html.js';
+
+const SettingsAeriumCleanupPageElementBase =
+    SettingsViewMixin(PrefsMixin(PolymerElement));
+
+export class SettingsAeriumCleanupPageElement extends
+    SettingsAeriumCleanupPageElementBase {
+  static get is() {
+    return 'settings-aerium-cleanup-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-aerium-cleanup-page': SettingsAeriumCleanupPageElement;
+  }
+}
+
+customElements.define(
+    SettingsAeriumCleanupPageElement.is, SettingsAeriumCleanupPageElement);
