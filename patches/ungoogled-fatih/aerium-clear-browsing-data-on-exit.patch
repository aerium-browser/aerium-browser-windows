+// Aerium: the removal mask for the "Delete browsing data when you close
+// Aerium" toggle, assembled from the per-type checkboxes that sit under it.
+// The type -> mask mapping is deliberately the same one GetRemoveMask() uses
+// for browsing_data::PolicyDataType, so the Settings toggle and the
+// enterprise ClearBrowsingDataOnExit policy clear identical things for
+// identical selections.
+uint64_t AeriumOnExitRemoveMask(PrefService* prefs) {
+  uint64_t result = 0;
+  if (prefs->GetBoolean(
+          browsing_data::prefs::kAeriumClearOnExitBrowsingHistory)) {
+    result |= chrome_browsing_data_remover::DATA_TYPE_HISTORY;
+  }
+  if (prefs->GetBoolean(
+          browsing_data::prefs::kAeriumClearOnExitDownloadHistory)) {
+    result |= content::BrowsingDataRemover::DATA_TYPE_DOWNLOADS;
+  }
+  if (prefs->GetBoolean(browsing_data::prefs::kAeriumClearOnExitCookies)) {
+    result |= chrome_browsing_data_remover::DATA_TYPE_SITE_DATA;
+  }
+  if (prefs->GetBoolean(browsing_data::prefs::kAeriumClearOnExitCache)) {
+    result |= content::BrowsingDataRemover::DATA_TYPE_CACHE;
+  }
+  if (prefs->GetBoolean(browsing_data::prefs::kAeriumClearOnExitFormData)) {
+    result |= chrome_browsing_data_remover::DATA_TYPE_FORM_DATA;
+  }
+  if (prefs->GetBoolean(browsing_data::prefs::kAeriumClearOnExitPasswords)) {
+    result |= chrome_browsing_data_remover::DATA_TYPE_PASSWORDS;
+  }
+  if (prefs->GetBoolean(browsing_data::prefs::kAeriumClearOnExitSiteSettings)) {
+    result |= chrome_browsing_data_remover::DATA_TYPE_CONTENT_SETTINGS;
+  }
+  if (prefs->GetBoolean(
+          browsing_data::prefs::kAeriumClearOnExitHostedAppData)) {
+    result |= chrome_browsing_data_remover::DATA_TYPE_SITE_DATA;
+  }
+  return result;
+}
+
+// Aerium: origin-type companion to AeriumOnExitRemoveMask(), mirroring
+// GetOriginTypeMask() below - only cookies/site data and hosted app data are
+// origin-scoped.
+uint64_t AeriumOnExitOriginTypeMask(PrefService* prefs) {
+  uint64_t result = 0;
+  if (prefs->GetBoolean(browsing_data::prefs::kAeriumClearOnExitCookies)) {
+    result |= content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB;
+  }
+  if (prefs->GetBoolean(
+          browsing_data::prefs::kAeriumClearOnExitHostedAppData)) {
+    result |= content::BrowsingDataRemover::ORIGIN_TYPE_PROTECTED_WEB;
+  }
+  return result;
+}
