+// Aerium: what the Settings toggle deletes. Deliberately narrower than
+// AllRemoveMask() above, which backs the #clear-data-on-exit flag: that one
+// also wipes saved passwords and site settings. A discoverable toggle in
+// Settings is going to be switched on by people who just want a clean slate
+// each session, and silently destroying their saved passwords and per-site
+// permissions every time they quit is not what the label promises.
+uint64_t AeriumOnExitRemoveMask() {
+  return content::BrowsingDataRemover::DATA_TYPE_CACHE |
+         content::BrowsingDataRemover::DATA_TYPE_DOWNLOADS |
+         chrome_browsing_data_remover::DATA_TYPE_FORM_DATA |
+         chrome_browsing_data_remover::DATA_TYPE_HISTORY |
+         chrome_browsing_data_remover::DATA_TYPE_SITE_DATA;
+}
