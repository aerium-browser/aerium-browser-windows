+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-clear-on-exit-sites' is the "never delete data for these sites"
+ * list that turns delete-on-exit into "clear everything except these",
+ * modelled on the Cookie AutoDelete whitelist.
+ *
+ * The list is a single list pref. settingsPrivate exposes list prefs as
+ * PrefType.LIST, which neither settings-toggle-button nor settings-checkbox
+ * can bind to, so this element goes through PrefsMixin's
+ * appendPrefListItem()/deletePrefListItem() helpers instead - which is what
+ * that pair of helpers exists for - and renders the same site-row plus
+ * add-site-dialog shape Chromium already uses for its own list-pref site
+ * exceptions under performance_page/tab_discard/.
+ *
+ * Entries are stored as bare hostnames. The browser folds each one to its
+ * registrable domain (eTLD+1) when it builds the deletion filter, so
+ * example.com covers www.example.com too; normalising here as well keeps the
+ * list free of duplicates that would look different but behave identically.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import 'chrome://resources/cr_elements/icons.html.js';
+import '../settings_shared.css.js';
+
+import type {CrButtonElement} from 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import type {PrefsMixinInterface} from '/shared/settings/prefs/prefs_mixin.js';
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {loadTimeData} from '../i18n_setup.js';
+
+import {getTemplate} from './clear_on_exit_sites.html.js';
+
+export const CLEAR_ON_EXIT_EXCLUDED_SITES_PREF: string =
+    'browser.clear_data.aerium_on_exit.excluded_sites';
+
+export interface ClearOnExitSitesElement {
+  $: {
+    addButton: CrButtonElement,
+    addDialog: CrDialogElement,
+    addSiteButton: CrButtonElement,
+    siteInput: CrInputElement,
+  };
+}
+
+type Constructor<T> = new (...args: any[]) => T;
+const ClearOnExitSitesElementBase = PrefsMixin(PolymerElement) as
+    Constructor<PrefsMixinInterface&PolymerElement>;
+
+export class ClearOnExitSitesElement extends ClearOnExitSitesElementBase {
+  static get is() {
+    return 'settings-clear-on-exit-sites';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      sites_: {
+        type: Array,
+        value: () => [],
+      },
+
+      newSite_: {
+        type: String,
+        value: '',
+      },
+
+      addDisabled_: {
+        type: Boolean,
+        value: true,
+      },
+
+      inputInvalid_: {
+        type: Boolean,
+        value: false,
+      },
+
+      errorMessage_: {
+        type: String,
+        value: '',
+      },
+    };
+  }
+
+  static get observers() {
+    return [
+      `onPrefChanged_(prefs.${CLEAR_ON_EXIT_EXCLUDED_SITES_PREF}.value.*)`,
+    ];
+  }
+
+  declare private sites_: string[];
+  declare private newSite_: string;
+  declare private addDisabled_: boolean;
+  declare private inputInvalid_: boolean;
+  declare private errorMessage_: string;
+
+  private onPrefChanged_() {
+    this.sites_ =
+        this.getPref<string[]>(CLEAR_ON_EXIT_EXCLUDED_SITES_PREF).value.slice();
+  }
+
+  private hasSites_(): boolean {
+    return this.sites_.length > 0;
+  }
+
+  /**
+   * Turns whatever the user typed into a bare hostname, or null if it cannot
+   * be one. Accepts a pasted URL and a content-settings style "[*.]example.com"
+   * pattern as well as a plain hostname, because people will type all three.
+   * The URL parser does the actual work, so IDN, IPv6 literals and ports are
+   * handled the same way the browser handles them everywhere else.
+   */
+  private normalizeSite_(input: string): string|null {
+    const trimmed = input.trim();
+    if (!trimmed) {
+      return null;
+    }
+    let candidate = trimmed.replace(/^\[\*\.\]/, '').replace(/^\*\./, '');
+    if (!candidate.includes('://')) {
+      candidate = 'https://' + candidate;
+    }
+    let url: URL;
+    try {
+      url = new URL(candidate);
+    } catch (e) {
+      return null;
+    }
+    return url.hostname || null;
+  }
+
+  private validate_() {
+    if (this.newSite_.trim() === '') {
+      // Empty input disables the action button without shouting at the user.
+      this.inputInvalid_ = false;
+      this.addDisabled_ = true;
+      this.errorMessage_ = '';
+      return;
+    }
+
+    const site = this.normalizeSite_(this.newSite_);
+    if (site === null) {
+      this.inputInvalid_ = true;
+      this.addDisabled_ = true;
+      this.errorMessage_ = loadTimeData.getString('clearOnExitSitesInvalid');
+      return;
+    }
+
+    if (this.sites_.includes(site)) {
+      this.inputInvalid_ = true;
+      this.addDisabled_ = true;
+      this.errorMessage_ = loadTimeData.getString('clearOnExitSitesDuplicate');
+      return;
+    }
+
+    this.inputInvalid_ = false;
+    this.addDisabled_ = false;
+    this.errorMessage_ = '';
