+// Copyright 2026 The Aerium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_AERIUM_BLOCKER_AERIUM_BLOCKER_SERVICE_H_
+#define CHROME_BROWSER_AERIUM_BLOCKER_AERIUM_BLOCKER_SERVICE_H_
+
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback_forward.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/aerium_blocker/aerium_blocker_prefs.h"
+#include "components/prefs/pref_change_registrar.h"
+
+namespace subresource_filter {
+class RulesetService;
+}
+
+class PrefService;
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+namespace aerium_blocker {
+
+// Aerium: turns filter lists into the indexed ruleset that
+// components/subresource_filter matches against.
+//
+// The engine is entirely Chromium's. subresource_filter already blocks
+// subresources before the request leaves the browser, already memory-maps a
+// flatbuffer ruleset shared by every renderer, and - since 152 - already
+// applies cosmetic rules. What it lacks is any way to point it at a filter
+// list a person chose. That is all this class does:
+//
+//   list text -> RuleParser -> proto::UrlRule / proto::StyleRule
+//             -> UnindexedRulesetWriter -> one merged unindexed file
+//             -> RulesetService::IndexAndStoreAndPublishRulesetIfNeeded()
+//
+// and from there the existing machinery indexes it, verifies the checksum,
+// versions it on disk and publishes it to every renderer. Nothing about the
+// matching path is Aerium's, which is the point: the fast, well-fuzzed part
+// stays Google's and the part that has an opinion about which lists to carry
+// is ours.
+//
+// Lists are merged into a single ruleset rather than kept as several, because
+// the indexed ruleset is one flatbuffer and matching walks one index. Enabling
+// a fourth list therefore costs a re-index, not a fourth lookup per request.
+//
+// One instance per browser process, owned by BrowserProcessImpl. See the note
+// in aerium_blocker_prefs.h for why the configuration is local_state.
+class AeriumBlockerService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // Fired after a rebuild finishes and the list bookkeeping in prefs has
+    // been updated, so the Settings page can show rule counts and errors
+    // without polling.
+    virtual void OnBlockerListsChanged() {}
+  };
+
+  // How the service reaches the RulesetService without depending on
+  // //chrome/browser.
+  //
+  // Nothing in this target includes browser_process.h, and that is deliberate
+  // rather than stylistic: //chrome/browser depends on this target, so an
+  // include back into it is a circular GN dependency. Chromium supports those
+  // through allow_circular_includes_from, but the documented cost is that the
+  // build graph then misses generated dependencies and fails at compile time,
+  // which on a 13-hour build is an expensive way to learn something. Handing
+  // in a getter removes the question.
+  //
+  // A getter rather than the pointer itself because the RulesetService is not
+  // necessarily constructed when this service is.
+  using RulesetServiceGetter =
+      base::RepeatingCallback<subresource_filter::RulesetService*()>;
+
+  // Creates the process-wide instance. Called once, from
+  // ChromeBrowserMainParts::PostBrowserStart(), which is after local_state and
+  // the system URL loader factory exist. Calling it twice is a programming
+  // error and CHECKs.
+  static void CreateInstance(
+      PrefService* local_state,
+      const base::FilePath& user_data_dir,
+      scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory,
+      RulesetServiceGetter ruleset_service_getter);
+
+  // The instance, or null before CreateInstance() has run - which is a real
+  // state the Settings handler can observe, since a WebUI can in principle be
+  // constructed before PostBrowserStart() on an unusual startup path.
+  static AeriumBlockerService* GetInstance();
+
+  AeriumBlockerService(
+      PrefService* local_state,
+      const base::FilePath& user_data_dir,
+      scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory,
+      RulesetServiceGetter ruleset_service_getter);
+
+  AeriumBlockerService(const AeriumBlockerService&) = delete;
+  AeriumBlockerService& operator=(const AeriumBlockerService&) = delete;
+
+  ~AeriumBlockerService();
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Adds a list by URL. Returns false if the URL is not a valid https URL or
+  // is already present - both of which the UI reports rather than silently
+  // producing a duplicate, which would double every rule it contributes.
+  bool AddCustomList(const std::string& url, const std::string& title);
+
+  // Removes a custom list. Built-in lists cannot be removed, only disabled, so
+  // that turning blocking back on never depends on remembering a URL.
+  bool RemoveCustomList(const std::string& url);
+
+  void SetListEnabled(const std::string& url, bool enabled);
+
+  // Fetches every enabled list now, regardless of when they were last fetched
+  // and regardless of the auto-update setting. This is the "Update now" button.
+  void UpdateListsNow();
+
+  // Re-reads the cached list text and rebuilds the ruleset without fetching.
+  // Used when a list is enabled, disabled, added or removed - all of which
+  // change what the ruleset should contain but none of which need the network.
+  void RebuildRuleset();
+
+  bool IsEnabled() const;
+
+  // The configured lists. Exposed so callers - the Settings handler above all -
+  // never need local_state, and therefore never need to include
+  // browser_process.h into a target //chrome/browser depends on.
+  std::vector<FilterList> GetLists() const;
+
+ private:
+  // The outcome of one rebuild, computed on a blocking sequence.
+  struct RebuildResult {
+    RebuildResult();
+    RebuildResult(const RebuildResult&) = delete;
+    RebuildResult& operator=(const RebuildResult&) = delete;
+    RebuildResult(RebuildResult&&);
+    RebuildResult& operator=(RebuildResult&&);
+    ~RebuildResult();
+
+    base::FilePath unindexed_path;
+    std::string content_version;
+    // Keyed by list URL, so counts and parse failures land back on the right
+    // row in Settings.
+    std::map<std::string, int> rule_counts;
+    std::map<std::string, std::string> errors;
+    bool ok = false;
+  };
+
+  void OnEnabledChanged();
+  void ScheduleNextUpdate();
+  void MaybeUpdateLists();
+  void FetchList(const FilterList& list);
+  void OnListFetched(std::string url,
+                     std::unique_ptr<std::string> body);
+  void OnRebuildComplete(RebuildResult result);
+
+  base::FilePath CacheFilePathFor(const std::string& url) const;
+
+  raw_ptr<PrefService> local_state_;
+  RulesetServiceGetter ruleset_service_getter_;
+  const base::FilePath cache_dir_;
+
+  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
+  // Keyed by list URL so a second update while one is in flight replaces that
+  // list's loader rather than running two fetches for the same file.
+  std::map<std::string, std::unique_ptr<network::SimpleURLLoader>> loaders_;
+
+  PrefChangeRegistrar pref_change_registrar_;
+  base::OneShotTimer update_timer_;
+
+  // Set while a rebuild is on the blocking sequence. A second request during
+  // that window sets `rebuild_queued_` instead of starting a parallel rebuild,
+  // because two rebuilds racing to write the same file is how a ruleset ends
+  // up half-written.
+  bool rebuild_in_progress_ = false;
+  bool rebuild_queued_ = false;
+
+  base::ObserverList<Observer> observers_;
+
+  base::WeakPtrFactory<AeriumBlockerService> weak_factory_{this};
+};
