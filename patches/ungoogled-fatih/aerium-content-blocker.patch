+        <cr-toggle checked="[[item.enabled]]" data-url$="[[item.url]]"
+            on-change="onListToggled_"
+            aria-label="[[item.title]]">
+        </cr-toggle>
+        <cr-icon-button class="icon-clear" data-url$="[[item.url]]"
+            on-click="onRemoveClick_" title="$i18n{remove}"
+            aria-label="$i18n{remove}"
+            hidden$="[[item.builtin]]">
+        </cr-icon-button>
+      </div>
+    </template>
+  </div>
+</template>
+
+<cr-dialog id="addDialog" close-text="$i18n{close}">
+  <div slot="title">$i18n{contentBlockerAddTitle}</div>
+  <div slot="body">
+    <cr-input id="urlInput" label="$i18n{contentBlockerAddUrlLabel}"
+        placeholder="https://example.com/list.txt"
+        value="{{newUrl_}}" on-input="validate_"
+        invalid="[[inputInvalid_]]" error-message="[[errorMessage_]]"
+        spellcheck="false" autofocus>
+    </cr-input>
+    <cr-input id="titleInput" label="$i18n{contentBlockerAddNameLabel}"
+        value="{{newTitle_}}" spellcheck="false">
+    </cr-input>
+  </div>
+  <div slot="button-container">
+    <cr-button class="cancel-button" on-click="onCancelClick_">
+      $i18n{cancel}
+    </cr-button>
+    <cr-button id="addConfirmButton" class="action-button"
