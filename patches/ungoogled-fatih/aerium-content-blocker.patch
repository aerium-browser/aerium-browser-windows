+// found in the LICENSE file.
+
+#include "chrome/browser/aerium_blocker/aerium_content_blocker_handler.h"
+
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/i18n/time_formatting.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/aerium_blocker/aerium_blocker_prefs.h"
+
+namespace settings {
+
+using aerium_blocker::AeriumBlockerService;
+using aerium_blocker::FilterList;
+
+AeriumContentBlockerHandler::AeriumContentBlockerHandler() = default;
+AeriumContentBlockerHandler::~AeriumContentBlockerHandler() = default;
+
+void AeriumContentBlockerHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "contentBlockerGetLists",
+      base::BindRepeating(&AeriumContentBlockerHandler::HandleGetLists,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "contentBlockerAddList",
+      base::BindRepeating(&AeriumContentBlockerHandler::HandleAddList,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "contentBlockerRemoveList",
+      base::BindRepeating(&AeriumContentBlockerHandler::HandleRemoveList,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "contentBlockerSetListEnabled",
+      base::BindRepeating(&AeriumContentBlockerHandler::HandleSetListEnabled,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "contentBlockerUpdateNow",
+      base::BindRepeating(&AeriumContentBlockerHandler::HandleUpdateNow,
+                          base::Unretained(this)));
+}
+
+void AeriumContentBlockerHandler::OnJavascriptAllowed() {
+  if (AeriumBlockerService* service = AeriumBlockerService::GetInstance()) {
+    observation_.Observe(service);
+  }
+}
+
+void AeriumContentBlockerHandler::OnJavascriptDisallowed() {
+  observation_.Reset();
+}
+
+void AeriumContentBlockerHandler::OnBlockerListsChanged() {
+  // Rebuilds finish long after the click that caused them - a fetch, a parse
+  // and an index - so the page is told rather than left to poll.
+  FireWebUIListener("content-blocker-lists-changed", BuildListsValue());
+}
+
+base::ListValue AeriumContentBlockerHandler::BuildListsValue() const {
+  base::ListValue out;
+  AeriumBlockerService* const service = AeriumBlockerService::GetInstance();
+  if (!service) {
+    return out;
+  }
+  for (const FilterList& list : service->GetLists()) {
+    base::DictValue dict;
+    dict.Set("url", list.url);
+    dict.Set("title", list.title);
+    dict.Set("enabled", list.enabled);
+    dict.Set("builtin", list.builtin);
+    dict.Set("ruleCount", list.rule_count);
+    dict.Set("error", list.error);
+    // Formatted here rather than in TypeScript: the page would otherwise have
+    // to reimplement date formatting for every locale the browser ships, and
+    // get it wrong differently from the rest of Settings.
+    dict.Set("lastUpdate",
+             list.last_update.is_null()
+                 ? std::string()
+                 : base::UTF16ToUTF8(base::TimeFormatShortDateAndTime(
+                       list.last_update)));
+    out.Append(std::move(dict));
+  }
+  return out;
+}
+
+void AeriumContentBlockerHandler::HandleGetLists(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(1u, args.size());
+  ResolveJavascriptCallback(args[0], BuildListsValue());
+}
+
+void AeriumContentBlockerHandler::HandleAddList(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(3u, args.size());
+  const std::string& url = args[1].GetString();
+  const std::string& title = args[2].GetString();
+
+  AeriumBlockerService* const service = AeriumBlockerService::GetInstance();
+  // The service validates rather than the page: a scheme check in TypeScript
+  // is a courtesy to the user, not a control, since anything reaching this
+  // handler could have skipped it.
+  const bool added = service && service->AddCustomList(url, title);
+  ResolveJavascriptCallback(args[0], base::Value(added));
+}
+
+void AeriumContentBlockerHandler::HandleRemoveList(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(1u, args.size());
+  if (AeriumBlockerService* service = AeriumBlockerService::GetInstance()) {
+    service->RemoveCustomList(args[0].GetString());
+  }
+}
+
+void AeriumContentBlockerHandler::HandleSetListEnabled(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(2u, args.size());
+  if (AeriumBlockerService* service = AeriumBlockerService::GetInstance()) {
+    service->SetListEnabled(args[0].GetString(), args[1].GetBool());
+  }
+}
+
+void AeriumContentBlockerHandler::HandleUpdateNow(
+    const base::ListValue& args) {
+  AllowJavascript();
+  if (AeriumBlockerService* service = AeriumBlockerService::GetInstance()) {
+    service->UpdateListsNow();
+  }
+}
+
+}  // namespace settings
