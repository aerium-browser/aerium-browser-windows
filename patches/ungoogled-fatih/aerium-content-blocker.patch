+// Copyright 2026 The Aerium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview 'settings-content-blocker' is the Settings section for
+ * Aerium's content blocker: which filter lists are carried, whether they
+ * refresh automatically, and a way to add lists of your own.
+ *
+ * The list data does not come through settings_private even though it is
+ * stored in a pref. Adding a list has to be validated and then fetched, and
+ * "Update now" is an action with no state to write, so both go through
+ * AeriumContentBlockerHandler. Rule counts and errors arrive the same way,
+ * pushed when a rebuild finishes rather than polled.
+ */
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+import 'chrome://resources/cr_elements/icons.html.js';
+import '../controls/settings_toggle_button.js';
+import '../settings_shared.css.js';
+
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import type {CrToggleElement} from 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+import type {PrefsMixinInterface} from '/shared/settings/prefs/prefs_mixin.js';
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import {addWebUiListener, sendWithPromise} from 'chrome://resources/js/cr.js';
+import {loadTimeData} from '../i18n_setup.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getTemplate} from './content_blocker.html.js';
+
+interface FilterListEntry {
+  url: string;
+  title: string;
+  enabled: boolean;
+  builtin: boolean;
+  ruleCount: number;
+  error: string;
+  lastUpdate: string;
+}
+
+export interface SettingsContentBlockerElement {
+  $: {
+    addDialog: CrDialogElement,
+  };
+}
+
+type Constructor<T> = new (...args: any[]) => T;
+
+const SettingsContentBlockerElementBase = PrefsMixin(PolymerElement) as
+    Constructor<PrefsMixinInterface&PolymerElement>;
+
+export class SettingsContentBlockerElement extends
+    SettingsContentBlockerElementBase {
+  static get is() {
+    return 'settings-content-blocker';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      lists_: {
+        type: Array,
+        value: () => [],
+      },
+
+      newUrl_: {
+        type: String,
+        value: '',
+      },
+
+      newTitle_: {
+        type: String,
+        value: '',
+      },
+
+      addDisabled_: {
+        type: Boolean,
+        value: true,
+      },
+
+      inputInvalid_: {
+        type: Boolean,
+        value: false,
+      },
+
+      errorMessage_: {
+        type: String,
+        value: '',
+      },
+
+      updating_: {
+        type: Boolean,
+        value: false,
+      },
+
+      updatedLabel_: {
+        type: String,
+        value: '',
+      },
+    };
+  }
+
+  declare private lists_: FilterListEntry[];
+  declare private newUrl_: string;
+  declare private newTitle_: string;
+  declare private addDisabled_: boolean;
+  declare private inputInvalid_: boolean;
+  declare private errorMessage_: string;
+  declare private updating_: boolean;
+  declare private updatedLabel_: string;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    addWebUiListener(
+        'content-blocker-lists-changed',
+        (lists: FilterListEntry[]) => this.onListsChanged_(lists));
+    sendWithPromise('contentBlockerGetLists')
+        .then(lists => this.onListsChanged_(lists as FilterListEntry[]));
+  }
+
+  private onListsChanged_(lists: FilterListEntry[]) {
+    this.lists_ = lists;
+    this.updating_ = false;
+    // The most recently refreshed list is the honest answer to "when was this
+    // last updated" - a list that failed to fetch has an older stamp, and
+    // reporting the oldest would make one dead custom list look like nothing
+    // had updated at all.
+    let newest = '';
+    for (const list of lists) {
+      if (list.lastUpdate && list.lastUpdate > newest) {
+        newest = list.lastUpdate;
+      }
+    }
+    this.updatedLabel_ = newest ?
+        loadTimeData.getStringF('contentBlockerLastUpdated', newest) :
+        loadTimeData.getString('contentBlockerNeverUpdated');
+  }
+
+  private listDetail_(list: FilterListEntry): string {
+    if (!list.enabled) {
+      return loadTimeData.getString('contentBlockerListOff');
+    }
+    return loadTimeData.getStringF(
+        'contentBlockerListDetail', list.ruleCount.toLocaleString());
+  }
+
+  private onListToggled_(event: Event) {
+    const toggle = event.target as CrToggleElement;
+    const url = toggle.dataset['url'];
+    if (url) {
+      chrome.send('contentBlockerSetListEnabled', [url, toggle.checked]);
+    }
+  }
+
+  private onRemoveClick_(event: Event) {
+    const url = (event.currentTarget as HTMLElement).dataset['url'];
+    if (url) {
+      chrome.send('contentBlockerRemoveList', [url]);
+    }
+  }
+
+  private onUpdateNowClick_() {
+    this.updating_ = true;
+    chrome.send('contentBlockerUpdateNow');
+  }
+
+  private onAddClick_() {
+    this.newUrl_ = '';
+    this.newTitle_ = '';
+    this.addDisabled_ = true;
+    this.inputInvalid_ = false;
+    this.errorMessage_ = '';
+    this.$.addDialog.showModal();
+  }
+
+  private onCancelClick_() {
+    this.$.addDialog.close();
+  }
+
+  /**
+   * https only, and no duplicates. Both are enforced again in the browser -
+   * this exists so the user is told why the button is disabled rather than
+   * having a submission silently rejected.
+   */
+  private validate_() {
+    const raw = this.newUrl_.trim();
+    if (!raw) {
+      this.inputInvalid_ = false;
+      this.errorMessage_ = '';
+      this.addDisabled_ = true;
+      return;
+    }
+
+    let parsed: URL;
+    try {
+      parsed = new URL(raw);
+    } catch (e) {
+      this.inputInvalid_ = true;
+      this.errorMessage_ = loadTimeData.getString('contentBlockerInvalidUrl');
+      this.addDisabled_ = true;
+      return;
+    }
+
+    if (parsed.protocol !== 'https:') {
+      this.inputInvalid_ = true;
+      this.errorMessage_ = loadTimeData.getString('contentBlockerHttpsOnly');
+      this.addDisabled_ = true;
+      return;
+    }
+
+    if (this.lists_.some(list => list.url === raw)) {
+      this.inputInvalid_ = true;
+      this.errorMessage_ = loadTimeData.getString('contentBlockerDuplicate');
+      this.addDisabled_ = true;
+      return;
+    }
+
+    this.inputInvalid_ = false;
+    this.errorMessage_ = '';
+    this.addDisabled_ = false;
+  }
+
+  private onSubmit_() {
+    const url = this.newUrl_.trim();
+    sendWithPromise('contentBlockerAddList', url, this.newTitle_.trim())
+        .then(added => {
+          if (added) {
+            this.$.addDialog.close();
+            return;
+          }
+          // The browser refused it after the page thought it was fine, which
+          // means the two disagree - show the generic reason rather than
+          // closing on a failure.
+          this.inputInvalid_ = true;
+          this.errorMessage_ =
+              loadTimeData.getString('contentBlockerInvalidUrl');
+        });
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-content-blocker': SettingsContentBlockerElement;
+  }
+}
+
+customElements.define(
+    SettingsContentBlockerElement.is, SettingsContentBlockerElement);
