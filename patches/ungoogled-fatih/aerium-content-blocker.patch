+#ifndef CHROME_BROWSER_AERIUM_BLOCKER_AERIUM_CONTENT_BLOCKER_HANDLER_H_
+#define CHROME_BROWSER_AERIUM_BLOCKER_AERIUM_CONTENT_BLOCKER_HANDLER_H_
+
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "chrome/browser/aerium_blocker/aerium_blocker_service.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+namespace settings {
+
+// Aerium: backs the content-blocker section of Settings > Privacy and security.
+//
+// The list configuration is a pref, so in principle the page could edit it
+// through settings_private and skip this entirely. It does not, for two
+// reasons. Adding a list has to be validated (https only, no duplicates) and
+// then fetched, neither of which a pref write can express. And "Update now" is
+// an action rather than a state - there is no value to store that means "do it
+// again", and inventing one would be a pref that exists to be a button.
+class AeriumContentBlockerHandler
+    : public content::WebUIMessageHandler,
+      public aerium_blocker::AeriumBlockerService::Observer {
+ public:
+  AeriumContentBlockerHandler();
+
+  AeriumContentBlockerHandler(const AeriumContentBlockerHandler&) = delete;
+  AeriumContentBlockerHandler& operator=(const AeriumContentBlockerHandler&) =
+      delete;
+
+  ~AeriumContentBlockerHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // aerium_blocker::AeriumBlockerService::Observer:
+  void OnBlockerListsChanged() override;
+
+ private:
+  void HandleGetLists(const base::ListValue& args);
+  void HandleAddList(const base::ListValue& args);
+  void HandleRemoveList(const base::ListValue& args);
+  void HandleSetListEnabled(const base::ListValue& args);
+  void HandleUpdateNow(const base::ListValue& args);
+
+  base::ListValue BuildListsValue() const;
+
+  base::ScopedObservation<aerium_blocker::AeriumBlockerService,
+                          aerium_blocker::AeriumBlockerService::Observer>
+      observation_{this};
+};
+
+}  // namespace settings
+
+#endif  // CHROME_BROWSER_AERIUM_BLOCKER_AERIUM_CONTENT_BLOCKER_HANDLER_H_
