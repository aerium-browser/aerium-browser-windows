+// Copyright 2026 The Aerium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/aerium_blocker/aerium_blocker_prefs.h"
+
+#include <iterator>
+#include <utility>
+
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "url/gurl.h"
+
+namespace aerium_blocker {
+namespace {
+
+constexpr char kUrlKey[] = "url";
+constexpr char kTitleKey[] = "title";
+constexpr char kEnabledKey[] = "enabled";
+constexpr char kBuiltinKey[] = "builtin";
+constexpr char kLastUpdateKey[] = "last_update";
+constexpr char kRuleCountKey[] = "rule_count";
+constexpr char kErrorKey[] = "error";
+constexpr char kContentHashKey[] = "content_hash";
+
+}  // namespace
+
+FilterList::FilterList() = default;
+FilterList::FilterList(const FilterList&) = default;
+FilterList& FilterList::operator=(const FilterList&) = default;
+FilterList::~FilterList() = default;
+
+// static
+FilterList FilterList::FromValue(const base::DictValue& dict) {
+  FilterList list;
+  if (const std::string* url = dict.FindString(kUrlKey)) {
+    list.url = *url;
+  }
+  if (const std::string* title = dict.FindString(kTitleKey)) {
+    list.title = *title;
+  }
+  list.enabled = dict.FindBool(kEnabledKey).value_or(true);
+  list.builtin = dict.FindBool(kBuiltinKey).value_or(false);
+  // Stored as microseconds since the Windows epoch, matching base::Time's own
+  // serialisation, so a value written by one platform reads back the same on
+  // another - profiles do get copied between machines.
+  if (std::optional<double> t = dict.FindDouble(kLastUpdateKey)) {
+    list.last_update = base::Time::FromDeltaSinceWindowsEpoch(
+        base::Microseconds(static_cast<int64_t>(*t)));
+  }
+  list.rule_count = dict.FindInt(kRuleCountKey).value_or(0);
+  if (const std::string* error = dict.FindString(kErrorKey)) {
+    list.error = *error;
+  }
+  if (const std::string* hash = dict.FindString(kContentHashKey)) {
+    list.content_hash = *hash;
+  }
+  return list;
+}
+
+base::DictValue FilterList::ToValue() const {
+  base::DictValue dict;
+  dict.Set(kUrlKey, url);
+  dict.Set(kTitleKey, title);
+  dict.Set(kEnabledKey, enabled);
+  dict.Set(kBuiltinKey, builtin);
+  dict.Set(kLastUpdateKey, static_cast<double>(
+                               last_update.ToDeltaSinceWindowsEpoch()
+                                   .InMicroseconds()));
+  dict.Set(kRuleCountKey, rule_count);
+  dict.Set(kErrorKey, error);
+  dict.Set(kContentHashKey, content_hash);
+  return dict;
+}
+
+std::vector<FilterList> DefaultLists() {
+  // The shipped set, and which of them start on.
+  //
+  // The defaults are uBlock Origin's, not a set assembled here. Its stock
+  // selection - the uBlock lists, EasyList, EasyPrivacy and Peter Lowe's - is
+  // the most widely exercised blocking configuration there is, tested against
+  // site breakage by millions of users daily. Picking a different combination
+  // would mean discovering that breakage ourselves.
+  //
+  // AdGuard's lists ship switched off rather than absent. They overlap EasyList
+  // heavily, so enabling them alongside it costs indexing time and memory for
+  // rules already present, but they cover things EasyList does not and some
+  // people want them. Present and off is the honest arrangement: the choice is
+  // there without the cost being imposed.
+  //
+  // Every URL here was fetched and confirmed to serve filter-list content
+  // before being written down. A default list that 404s is a blocker that
+  // silently does less than it claims.
+  struct Seed {
+    const char* url;
+    const char* title;
+    bool enabled;
+  };
+  static constexpr Seed kSeeds[] = {
+      // uBlock Origin's own lists. "filters" is the main one; badware and
+      // privacy are separate upstream and are separate here for the same
+      // reason - they are updated on different cadences.
+      {"https://ublockorigin.github.io/uAssets/filters/filters.txt",
+       "uBlock Origin filters", true},
+      {"https://ublockorigin.github.io/uAssets/filters/badware.txt",
+       "uBlock Origin badware risks", true},
+      {"https://ublockorigin.github.io/uAssets/filters/privacy.txt",
+       "uBlock Origin privacy", true},
+
+      // The EasyList family, which almost every blocker builds on.
+      {"https://easylist.to/easylist/easylist.txt", "EasyList", true},
+      {"https://easylist.to/easylist/easyprivacy.txt", "EasyPrivacy", true},
+
+      // Peter Lowe's server list: hosts rather than patterns, so it overlaps
+      // the others very little for its size.
+      {"https://pgl.yoyo.org/adservers/serverlist.php?hostformat=adblockplus"
+       "&mimetype=plaintext",
+       "Peter Lowe's ad and tracking servers", true},
+
+      // Off by default - see above.
+      {"https://filters.adtidy.org/extension/chromium/filters/2.txt",
+       "AdGuard Base", false},
+      {"https://filters.adtidy.org/extension/chromium/filters/3.txt",
+       "AdGuard Tracking Protection", false},
+      {"https://filters.adtidy.org/extension/chromium/filters/14.txt",
+       "AdGuard Annoyances", false},
+
+      // Cookie banners. Off by default because hiding the banner without
+      // answering it leaves the site's own default consent in place, which is
+      // not what someone switching it on necessarily expects.
+      {"https://secure.fanboy.co.nz/fanboy-cookiemonster.txt",
+       "EasyList Cookie", false},
+  };
+
+  std::vector<FilterList> lists;
+  lists.reserve(std::size(kSeeds));
+  for (const Seed& seed : kSeeds) {
+    FilterList list;
+    list.url = seed.url;
+    list.title = seed.title;
+    list.enabled = seed.enabled;
+    list.builtin = true;
+    lists.push_back(std::move(list));
+  }
+  return lists;
+}
+
+void RegisterLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kAeriumBlockerEnabled, true);
+  registry->RegisterListPref(kAeriumBlockerLists);
+  registry->RegisterBooleanPref(kAeriumBlockerAutoUpdate, true);
+  registry->RegisterTimePref(kAeriumBlockerLastUpdate, base::Time());
+}
+
+std::vector<FilterList> GetLists(PrefService* local_state) {
+  std::vector<FilterList> lists;
+  const base::ListValue& stored = local_state->GetList(kAeriumBlockerLists);
+  for (const base::Value& entry : stored) {
+    if (!entry.is_dict()) {
+      continue;
+    }
+    FilterList list = FilterList::FromValue(entry.GetDict());
+    // A stored entry with no URL cannot be fetched or identified, so it can
+    // only ever be dead weight in the merge.
+    if (list.url.empty() || !GURL(list.url).is_valid()) {
+      continue;
+    }
+    lists.push_back(std::move(list));
+  }
+
+  // First run, or a profile whose list pref was wiped. Seed rather than leave
+  // the user with blocking switched on and nothing to block with.
+  if (lists.empty()) {
+    lists = DefaultLists();
+    SetLists(local_state, lists);
+    return lists;
+  }
+
+  // A build that adds a built-in list must reach existing profiles too. Match
+  // on URL so a list the user switched off stays off - re-enabling something
+  // deliberately disabled on every upgrade would be its own bug.
+  bool added = false;
+  for (const FilterList& def : DefaultLists()) {
+    bool present = false;
+    for (const FilterList& have : lists) {
+      if (have.url == def.url) {
+        present = true;
+        break;
+      }
+    }
+    if (!present) {
+      // Pushed with its own default enabled state, which for the AdGuard and
+      // cookie lists is off. A new built-in must not switch itself on in an
+      // existing profile just because the build learned about it.
+      lists.push_back(def);
+      added = true;
+    }
+  }
+  if (added) {
+    SetLists(local_state, lists);
+  }
+  return lists;
+}
+
+void SetLists(PrefService* local_state, const std::vector<FilterList>& lists) {
+  base::ListValue out;
+  for (const FilterList& list : lists) {
+    out.Append(list.ToValue());
+  }
+  local_state->SetList(kAeriumBlockerLists, std::move(out));
+}
+
+}  // namespace aerium_blocker
