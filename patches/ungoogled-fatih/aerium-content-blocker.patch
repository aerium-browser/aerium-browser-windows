+  ]
+
+  deps = [
+    "//base",
+    # base/i18n/time_formatting.h, used to render the "last updated" stamp in
+    # the locale the rest of Settings uses. Its own target, and //base does not
+    # public_dep it - checked, because base/i18n lives in component("i18n")
+    # specifically so that everything depending on //base does not drag ICU in.
+    "//base:i18n",
+    "//components/prefs",
+    "//content/public/browser",
+    # The EasyList parser and the indexed/unindexed ruleset writers. Both are
+    # ordinary non-testonly targets - checked, because if they had been
+    # host-tool-only the lists would have had to be baked in at build time and
