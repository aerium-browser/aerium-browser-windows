+// Copyright 2026 The Aerium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_AERIUM_BLOCKER_AERIUM_BLOCKER_PREFS_H_
+#define CHROME_BROWSER_AERIUM_BLOCKER_AERIUM_BLOCKER_PREFS_H_
+
+#include <string>
+#include <vector>
+
+#include "base/time/time.h"
+#include "base/values.h"
+
+class PrefRegistrySimple;
+class PrefService;
+
+namespace aerium_blocker {
+
+// Aerium: everything here lives in local_state rather than in profile prefs.
+// The ruleset it configures is a single indexed file shared by every renderer
+// in the process, which is how subresource_filter is built - RulesetService
+// takes a user data dir and a PrefService for its version bookkeeping, not a
+// profile. Splitting the configuration per profile while the artefact it
+// produces is global would let two profiles disagree about a file only one of
+// them can win. settings_private reaches local_state prefs on its own
+// (PrefsUtil::FindServiceForPref falls back to it), so the settings UI is
+// unaffected by the choice.
+
+// Whether content blocking is on at all.
+inline constexpr char kAeriumBlockerEnabled[] = "aerium.blocker.enabled";
+
+// The filter lists, as a list of dicts. See FilterList below for the shape.
+inline constexpr char kAeriumBlockerLists[] = "aerium.blocker.lists";
+
+// Whether lists are refreshed from their URLs automatically.
+inline constexpr char kAeriumBlockerAutoUpdate[] = "aerium.blocker.auto_update";
+
+// When the last automatic refresh completed, so a browser that is closed for a
+// week refreshes on the next launch instead of waiting out a fresh interval.
+inline constexpr char kAeriumBlockerLastUpdate[] = "aerium.blocker.last_update";
+
+// One filter list. Built-in lists are seeded on first run and cannot be
+// removed - only switched off - so that turning blocking back on never depends
+// on the user remembering a URL. Custom lists are whatever the user adds.
+struct FilterList {
+  FilterList();
+  FilterList(const FilterList&);
+  FilterList& operator=(const FilterList&);
+  ~FilterList();
+
+  static FilterList FromValue(const base::DictValue& dict);
+  base::DictValue ToValue() const;
+
+  // Identity. The URL is the key: adding a list that is already present
+  // updates it rather than producing a second copy that would double every
+  // rule in the merged ruleset.
+  std::string url;
+  std::string title;
+
+  bool enabled = true;
+  bool builtin = false;
+
+  // Bookkeeping, all of it surfaced in Settings. `error` is empty on success
+  // and holds a human-readable reason otherwise - a list that fetched as an
+  // HTML error page has to say so, because a silently empty list looks
+  // identical to a list with nothing left to block.
+  base::Time last_update;
+  int rule_count = 0;
+  std::string error;
+
+  // Hash of the raw list text as last fetched. Feeds the ruleset's content
+  // version, which is how RulesetService decides whether re-indexing is needed
+  // at all: unchanged lists produce an unchanged version and cost nothing.
+  std::string content_hash;
+};
+
+void RegisterLocalStatePrefs(PrefRegistrySimple* registry);
+
+// Reads the configured lists, seeding the built-in set the first time.
+std::vector<FilterList> GetLists(PrefService* local_state);
+void SetLists(PrefService* local_state, const std::vector<FilterList>& lists);
+
+// The lists Aerium ships with. EasyList and EasyPrivacy are the baseline every
+// blocker starts from; AdGuard's base list overlaps EasyList deliberately -
+// the indexer folds duplicate rules, so the cost of both is far below the sum
+// of the two and the coverage is strictly better.
+std::vector<FilterList> DefaultLists();
+
+}  // namespace aerium_blocker
+
+#endif  // CHROME_BROWSER_AERIUM_BLOCKER_AERIUM_BLOCKER_PREFS_H_
