+void ChromeBrowsingDataLifetimeManager::AeriumClearClosedEphemeralSites() {
+  PrefService* const prefs = profile_->GetPrefs();
+  const bool all_sites =
+      prefs->GetBoolean(browsing_data::prefs::kAeriumEphemeralAllSites);
+  const std::set<std::string> ephemeral = AeriumDomainsFromPref(
+      prefs, browsing_data::prefs::kAeriumEphemeralSites);
+  if (!all_sites && ephemeral.empty()) {
     return;
   }
+  const std::set<std::string> still_open =
+      AeriumOpenRegistrableDomains(profile_);
