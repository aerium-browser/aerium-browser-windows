+  std::unique_ptr<content::BrowsingDataFilterBuilder> filter;
+  if (all_sites) {
+    // Cookie AutoDelete's model: delete every site except the ones being kept.
+    // Expressed as a kPreserve filter rather than by enumerating what to
+    // delete, because the set of domains holding data is not knowable from
+    // here - and even if it were, listing it would be a much larger filter
+    // than listing the handful being spared.
+    //
+    // Three things are spared. The keep list, because the user said so. The
+    // greylist, because it is kept until shutdown and this is not shutdown.
+    // And whatever is still open, because clearing a site out from under a tab
+    // that is displaying it logs the user out mid-session - the explicit-list
+    // path has always protected open sites and this one must too, all the more
+    // so now that every site is a candidate.
+    filter = content::BrowsingDataFilterBuilder::Create(
+        content::BrowsingDataFilterBuilder::Mode::kPreserve);
+    std::set<std::string> keep = AeriumDomainsFromPref(
+        prefs, browsing_data::prefs::kAeriumClearOnExitExcludedSites);
+    const std::set<std::string> session_only = AeriumDomainsFromPref(
+        prefs, browsing_data::prefs::kAeriumSessionOnlySites);
+    keep.insert(session_only.begin(), session_only.end());
+    keep.insert(still_open.begin(), still_open.end());
+    for (const std::string& domain : keep) {
+      filter->AddRegisterableDomain(domain);
+    }
