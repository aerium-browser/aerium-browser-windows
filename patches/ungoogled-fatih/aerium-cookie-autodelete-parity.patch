+void ChromeBrowsingDataLifetimeManager::AeriumScheduleEphemeralClear() {
+  // Posted rather than run inline for two reasons that both matter. At the
+  // moment a tab is removed it can still be reachable from the model, so an
+  // immediate walk would see the site as open and clear nothing. And the user's
+  // delay has to be honoured, which is the other half of why this is a hop.
+  //
+  // The weak pointer is the cancellation mechanism: Shutdown() invalidates the
+  // factory, so a pending clear posted before teardown never runs against a
+  // half-destroyed profile. That is why the delay needs no timer of its own.
+  int delay_seconds = profile_->GetPrefs()->GetInteger(
+      browsing_data::prefs::kAeriumEphemeralDelaySeconds);
+  // Clamped, not trusted. The pref is reachable through settings_private and a
+  // negative value would be read as an immediate task while a very large one
+  // would silently disable the feature; an hour is well past any redirect this
+  // is meant to survive.
+  delay_seconds = std::clamp(delay_seconds, 0, 3600);
+  content::GetUIThreadTaskRunner({})->PostDelayedTask(
       FROM_HERE,
       base::BindOnce(
           &ChromeBrowsingDataLifetimeManager::AeriumClearClosedEphemeralSites,
-          weak_ptr_factory_.GetWeakPtr()));
+          weak_ptr_factory_.GetWeakPtr()),
+      base::Seconds(delay_seconds));
 }
 
