--- a/chrome/browser/chrome_browser_main.cc
+++ b/chrome/browser/chrome_browser_main.cc
@@ -1131,6 +1131,27 @@
     }
   }
 
+  // Aerium: DRM is opt-in. PreCreateThreadsImpl above has loaded Local State,
+  // and BrowserMainLoop::PreCreateThreads() calls CdmRegistry::Init() straight
+  // after this function returns - so this is the last point at which the
+  // browser's own CDM registration can still be told not to happen.
+  //
+  // Turned into a command-line switch rather than read directly by
+  // cdm_registration.cc, which lives in chrome/common and has no business
+  // reaching into the browser process for a PrefService. It also means every
+  // platform reads exactly one thing: Android sets the same switch from Java
+  // before native starts.
+  //
+  // On Linux the zygote has already dlopen'd the library before the sandbox
+  // closed and nothing here can undo that. What this controls is whether the
+  // browser registers it, which is what decides whether a page can ask for it.
+  if (PrefService* aerium_local_state = g_browser_process->local_state()) {
+    if (aerium_local_state->GetBoolean("aerium.drm_enabled") &&
+        !base::CommandLine::ForCurrentProcess()->HasSwitch("enable-widevine")) {
+      base::CommandLine::ForCurrentProcess()->AppendSwitch("enable-widevine");
+    }
+  }
+
