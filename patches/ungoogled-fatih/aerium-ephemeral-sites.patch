+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-ephemeral-sites' is the "reset these sites when their last tab
+ * closes" list. It is the mirror image of settings-clear-on-exit-sites next to
+ * it: that one names sites to keep when the browser quits, this one names
+ * sites that should never persist at all.
+ *
+ * Deliberately independent of the delete-on-exit toggle, and so rendered
+ * outside its cr-collapse - being ephemeral is a property of the site, not of
+ * the session, and the feature works whether or not that toggle is on.
+ *
+ * Same storage mechanics as its sibling: a single list pref, which
+ * settingsPrivate exposes as PrefType.LIST and which therefore cannot be bound
+ * by settings-toggle-button or settings-checkbox, so this goes through
+ * PrefsMixin's appendPrefListItem()/deletePrefListItem() instead.
+ *
+ * The description string promises cookies and site storage and nothing more,
+ * because that is all the browser can honestly deliver: history, autofill,
+ * passwords and site settings ignore the origin filter, so they can only be
+ * cleared for every site at once.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import 'chrome://resources/cr_elements/icons.html.js';
+import '../settings_shared.css.js';
+
+import type {CrButtonElement} from 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import type {PrefsMixinInterface} from '/shared/settings/prefs/prefs_mixin.js';
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {loadTimeData} from '../i18n_setup.js';
+
+import {getTemplate} from './ephemeral_sites.html.js';
+
+export const EPHEMERAL_SITES_PREF: string =
+    'browser.clear_data.aerium_ephemeral_sites';
+
+export interface EphemeralSitesElement {
+  $: {
+    addButton: CrButtonElement,
+    addDialog: CrDialogElement,
+    addSiteButton: CrButtonElement,
+    siteInput: CrInputElement,
+  };
+}
+
+type Constructor<T> = new (...args: any[]) => T;
+const EphemeralSitesElementBase = PrefsMixin(PolymerElement) as
+    Constructor<PrefsMixinInterface&PolymerElement>;
+
+export class EphemeralSitesElement extends EphemeralSitesElementBase {
+  static get is() {
+    return 'settings-ephemeral-sites';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      sites_: {
+        type: Array,
+        value: () => [],
+      },
+
+      newSite_: {
+        type: String,
+        value: '',
+      },
+
+      addDisabled_: {
+        type: Boolean,
+        value: true,
+      },
+
+      inputInvalid_: {
+        type: Boolean,
+        value: false,
+      },
+
+      errorMessage_: {
+        type: String,
+        value: '',
+      },
+    };
+  }
+
+  static get observers() {
+    return [
+      `onPrefChanged_(prefs.${EPHEMERAL_SITES_PREF}.value.*)`,
+    ];
+  }
+
+  declare private sites_: string[];
+  declare private newSite_: string;
+  declare private addDisabled_: boolean;
+  declare private inputInvalid_: boolean;
+  declare private errorMessage_: string;
+
+  private onPrefChanged_() {
+    this.sites_ = this.getPref<string[]>(EPHEMERAL_SITES_PREF).value.slice();
+  }
+
+  private hasSites_(): boolean {
+    return this.sites_.length > 0;
+  }
+
+  /**
+   * Turns whatever the user typed into a bare hostname, or null if it cannot
+   * be one. Accepts a pasted URL and a content-settings style "[*.]example.com"
+   * pattern as well as a plain hostname, because people will type all three.
+   * The URL parser does the actual work, so IDN, IPv6 literals and ports are
+   * handled the same way the browser handles them everywhere else.
+   */
+  private normalizeSite_(input: string): string|null {
+    const trimmed = input.trim();
+    if (!trimmed) {
+      return null;
+    }
+    let candidate = trimmed.replace(/^\[\*\.\]/, '').replace(/^\*\./, '');
+    if (!candidate.includes('://')) {
+      candidate = 'https://' + candidate;
+    }
+    let url: URL;
+    try {
+      url = new URL(candidate);
+    } catch (e) {
+      return null;
+    }
+    return url.hostname || null;
+  }
+
+  private validate_() {
+    if (this.newSite_.trim() === '') {
+      // Empty input disables the action button without shouting at the user.
+      this.inputInvalid_ = false;
+      this.addDisabled_ = true;
+      this.errorMessage_ = '';
+      return;
+    }
+
+    const site = this.normalizeSite_(this.newSite_);
+    if (site === null) {
+      this.inputInvalid_ = true;
+      this.addDisabled_ = true;
+      this.errorMessage_ = loadTimeData.getString('ephemeralSitesInvalid');
+      return;
+    }
+
+    if (this.sites_.includes(site)) {
+      this.inputInvalid_ = true;
+      this.addDisabled_ = true;
+      this.errorMessage_ = loadTimeData.getString('ephemeralSitesDuplicate');
+      return;
+    }
+
+    this.inputInvalid_ = false;
+    this.addDisabled_ = false;
+    this.errorMessage_ = '';
+  }
+
+  private onAddClick_() {
+    this.newSite_ = '';
+    this.inputInvalid_ = false;
+    this.addDisabled_ = true;
+    this.errorMessage_ = '';
+    this.$.addDialog.showModal();
+  }
+
+  private onCancelClick_() {
+    this.$.addDialog.cancel();
+  }
+
+  private onSubmit_() {
+    const site = this.normalizeSite_(this.newSite_);
+    if (site === null || this.sites_.includes(site)) {
+      return;
+    }
+    this.appendPrefListItem(EPHEMERAL_SITES_PREF, site);
+    this.$.addDialog.close();
+  }
+
+  private onRemoveClick_(e: Event) {
+    const site = (e.currentTarget as HTMLElement).dataset['site'];
+    if (site === undefined) {
+      return;
+    }
+    this.deletePrefListItem(EPHEMERAL_SITES_PREF, site);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-ephemeral-sites': EphemeralSitesElement;
+  }
+}
+
+customElements.define(EphemeralSitesElement.is, EphemeralSitesElement);
