+  // Adds chrome://flags entries to the local-state list about_flags reads at
+  // startup, leaving anything already in it (including the seed from
+  // default-flags.patch) alone. Entry syntax comes from
+  // FeatureEntry::NameForOption(): a SINGLE_VALUE_TYPE entry is stored under
+  // its bare internal name, while FEATURE_VALUE_TYPE has three options and
+  // "@1" means Enabled.
+  static void SeedFlags(PrefService* local_state,
+                        const std::vector<std::string>& entries) {
+    // flags_ui::prefs::kAboutFlagsEntries.
+    static constexpr char kAboutFlagsEntries[] =
+        "browser.enabled_labs_experiments";
+    base::ListValue list = local_state->GetList(kAboutFlagsEntries).Clone();
+    for (const std::string& entry : entries) {
+      if (!list.contains(entry))
+        list.Append(entry);
+    }
+    local_state->SetList(kAboutFlagsEntries, std::move(list));
+  }
+
+  // Applies one of the first-run presets. Pref paths are spelled out rather
+  // than pulled in through half a dozen headers; every one is registered at
+  // 151 and the patch header records where each is declared. Integer prefs
+  // use literal values with the enumerator named in a comment, for the same
+  // reason.
+  void HandleApplyPreset(const base::ListValue& args) {
+    if (args.size() != 1 || !args[0].is_string())
+      return;
+    const std::string& preset = args[0].GetString();
+    if (preset != "recommended" && preset != "privacy" &&
+        preset != "performance")
+      return;
+
+    Profile* profile = Profile::FromWebUI(web_ui());
+    if (!profile)
+      return;
+    PrefService* prefs = profile->GetPrefs();
+    PrefService* local_state = g_browser_process->local_state();
+    if (!prefs || !local_state)
+      return;
+
+    const bool privacy = preset == "privacy";
+    const bool performance = preset == "performance";
+
+    // Profile prefs.
+    prefs->SetBoolean("enable_do_not_track", true);
+    // content_settings::CookieControlsMode::kBlockThirdParty.
+    prefs->SetInteger("profile.cookie_controls_mode", 1);
+    // prefetch::NetworkPredictionOptions: kStandard = 0, kDisabled = 2.
+    prefs->SetInteger("net.network_prediction_options", performance ? 0 : 2);
+    prefs->SetBoolean("browser.clear_data.aerium_clear_on_exit", privacy);
+    prefs->SetBoolean("search.suggest_enabled", !privacy);
+
+    // Memory and battery saver are local-state prefs - they are browser-wide,
+    // not per profile.
+    // performance_manager MemorySaverModeState::kEnabled = 2.
+    local_state->SetInteger("performance_tuning.high_efficiency_mode.state", 2);
+    // BatterySaverModeState: kDisabled = 0, kEnabledOnBattery = 2.
+    local_state->SetInteger("performance_tuning.battery_saver_mode.state",
+                            performance ? 0 : 2);
+
+    std::vector<std::string> flags{
+        "disable-search-engine-collection",  // SINGLE_VALUE_TYPE
+        "remove-client-hints@1",             // FEATURE_VALUE_TYPE, Enabled
+    };
+    if (privacy) {
+      flags.push_back("fingerprinting-canvas-image-data-noise");
+      flags.push_back("fingerprinting-canvas-measuretext-noise");
+      flags.push_back("fingerprinting-client-rects-noise");
+      flags.push_back("force-punycode-hostnames");
+      flags.push_back("reduced-system-info@1");
+      flags.push_back("increase-incognito-storage-quota@1");
+    }
+    if (performance)
+      flags.push_back("enable-parallel-downloading@1");
+    SeedFlags(local_state, flags);
+  }
 };
 
