+    local_state->SetInteger("performance_tuning.battery_saver_mode.state",
+                            performance ? 0 : 2);
+    // Do not keep a process alive once the last window closes.
+    local_state->SetBoolean("background_mode.enabled", false);
+
+    std::vector<std::string> flags{
+        "disable-search-engine-collection",  // SINGLE_VALUE_TYPE
+        "remove-client-hints@1",             // FEATURE_VALUE_TYPE, Enabled
+    };
+    if (privacy) {
+      flags.push_back("fingerprinting-canvas-image-data-noise");
+      flags.push_back("fingerprinting-canvas-measuretext-noise");
+      flags.push_back("fingerprinting-client-rects-noise");
+      flags.push_back("force-punycode-hostnames");
+      flags.push_back("spoof-webgl-info@1");   // FEATURE_WITH_PARAMS, Enabled
+      flags.push_back("reduced-system-info@1");
+      flags.push_back("minimal-referrers@1");
+      flags.push_back("increase-incognito-storage-quota@1");
+    }
+    if (performance) {
+      flags.push_back("enable-parallel-downloading@1");
+      flags.push_back("max-connections-per-host@1");  // MULTI_VALUE, "15"
+    }
+    SeedFlags(local_state, flags);
+  }
 };
 
 #endif  // CHROME_BROWSER_UI_WEBUI_UNGOOGLED_FIRST_RUN_H_
