@@ -0,0 +1,276 @@
+#include "chrome/browser/ui/views/location_bar/aerium_guard_icon_view.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_bubble_delegate_view.h"
+#include "chrome/browser/ui/webui/aerium_presets.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/prefs/pref_service.h"
+#include "components/vector_icons/vector_icons.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/mojom/dialog_button.mojom.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/bubble/bubble_dialog_delegate_view.h"
+#include "ui/views/controls/button/radio_button.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/layout/layout_provider.h"
+#include "ui/views/style/typography.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+// The profile whose prefs a mode is read from and written to. Off-the-record
+// profiles get an overlay PrefService whose writes are discarded when the last
+// incognito window closes, which would make the button silently forget what it
+// was told; chrome://settings has the same problem and solves it the same way,
+// by working on the profile the window was opened from.
+Profile* PrefProfile(Profile* profile) {
+  return profile ? profile->GetOriginalProfile() : nullptr;
+}
+
+PrefService* ProfilePrefsOf(Profile* profile) {
+  return profile ? profile->GetPrefs() : nullptr;
+}
+
+PrefService* LocalState() {
+  return g_browser_process ? g_browser_process->local_state() : nullptr;
+}
+
+std::string ActivePreset(Profile* profile) {
+  return aerium_presets::DetectPreset(ProfilePrefsOf(profile), LocalState());
+}
+
+// The mode names the bubble shows are the ones the Aerium Guard settings page
+// shows, taken from the same messages. settings_strings.grdp is a <part> of
+// generated_resources.grd, so these IDS_SETTINGS_* symbols are in the same
+// generated header the rest of the browser UI uses.
+int ModeLabelId(std::string_view preset) {
+  if (preset == aerium_presets::kPrivacy) {
+    return IDS_SETTINGS_AERIUM_GUARD_PRIVACY_LABEL;
+  }
+  if (preset == aerium_presets::kPerformance) {
+    return IDS_SETTINGS_AERIUM_GUARD_PERFORMANCE_LABEL;
+  }
+  if (preset == aerium_presets::kRecommended) {
+    return IDS_SETTINGS_AERIUM_GUARD_RECOMMENDED_LABEL;
+  }
+  return IDS_SETTINGS_AERIUM_GUARD_CUSTOM_LABEL;
+}
+
+}  // namespace
+
+// The bubble the button opens: the three modes as a radio group, the note about
+// flags needing a restart, and - only when the current settings match no mode -
+// a line saying so. Picking a mode applies it straight away through
+// aerium_presets::ApplyPreset(), the same call the settings page's handler
+// makes, so the two cannot disagree about what a mode is.
+//
+// Deliberately not offered here: any way to edit an individual setting. This is
+// a shortcut for switching modes, and the settings page remains the place where
+// the pieces are.
+class AeriumGuardBubbleView : public LocationBarBubbleDelegateView {
+  METADATA_HEADER(AeriumGuardBubbleView, LocationBarBubbleDelegateView)
+
+ public:
+  AeriumGuardBubbleView(views::View* anchor_view,
+                        content::WebContents* web_contents,
+                        Profile* profile);
+  AeriumGuardBubbleView(const AeriumGuardBubbleView&) = delete;
+  AeriumGuardBubbleView& operator=(const AeriumGuardBubbleView&) = delete;
+  ~AeriumGuardBubbleView() override;
+
+ private:
+  void OnModePicked(const char* preset);
+  void SyncToActivePreset();
+
+  const raw_ptr<Profile> profile_;
+  raw_ptr<views::Label> custom_note_ = nullptr;
+  raw_ptr<views::RadioButton> recommended_ = nullptr;
+  raw_ptr<views::RadioButton> privacy_ = nullptr;
+  raw_ptr<views::RadioButton> performance_ = nullptr;
+};
+
+AeriumGuardBubbleView::AeriumGuardBubbleView(
+    views::View* anchor_view,
+    content::WebContents* web_contents,
+    Profile* profile)
+    : LocationBarBubbleDelegateView(anchor_view,
+                                    web_contents,
+                                    /*autosize=*/true),
+      profile_(profile) {
+  SetShowCloseButton(true);
+  SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  SetTitle(IDS_SETTINGS_AERIUM_GUARD_PAGE_TITLE);
+
+  views::LayoutProvider* const provider = views::LayoutProvider::Get();
+  set_fixed_width(
+      provider->GetDistanceMetric(views::DISTANCE_BUBBLE_PREFERRED_WIDTH));
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+      provider->GetDistanceMetric(views::DISTANCE_RELATED_CONTROL_VERTICAL)));
+
+  auto add_note = [this](int message_id) {
+    auto label = std::make_unique<views::Label>(
+        l10n_util::GetStringUTF16(message_id), views::style::CONTEXT_LABEL,
+        views::style::STYLE_SECONDARY);
+    label->SetMultiLine(true);
+    label->SetHorizontalAlignment(gfx::ALIGN_TO_HEAD);
+    return AddChildView(std::move(label));
+  };
+  auto add_mode = [this](int label_id, const char* preset) {
+    auto radio = std::make_unique<views::RadioButton>(
+        l10n_util::GetStringUTF16(label_id), /*group_id=*/0);
+    radio->SetCallback(base::BindRepeating(
+        &AeriumGuardBubbleView::OnModePicked, base::Unretained(this), preset));
+    return AddChildView(std::move(radio));
+  };
+
+  add_note(IDS_SETTINGS_AERIUM_GUARD_BUBBLE_DESC);
+  custom_note_ = add_note(IDS_SETTINGS_AERIUM_GUARD_BUBBLE_CUSTOM_NOTE);
+  recommended_ = add_mode(IDS_SETTINGS_AERIUM_GUARD_RECOMMENDED_LABEL,
+                          aerium_presets::kRecommended);
+  privacy_ = add_mode(IDS_SETTINGS_AERIUM_GUARD_PRIVACY_LABEL,
+                      aerium_presets::kPrivacy);
+  performance_ = add_mode(IDS_SETTINGS_AERIUM_GUARD_PERFORMANCE_LABEL,
+                          aerium_presets::kPerformance);
+  add_note(IDS_SETTINGS_AERIUM_GUARD_RESTART_NOTE);
+
+  SyncToActivePreset();
+}
+
+AeriumGuardBubbleView::~AeriumGuardBubbleView() = default;
+
+void AeriumGuardBubbleView::OnModePicked(const char* preset) {
+  aerium_presets::ApplyPreset(preset, ProfilePrefsOf(profile_), LocalState());
+  // Re-read rather than trusting the click: ApplyPreset() refuses to do
+  // anything without both PrefServices, and the radio group has already drawn
+  // itself as selected by the time the callback runs.
+  SyncToActivePreset();
+}
+
+void AeriumGuardBubbleView::SyncToActivePreset() {
+  const std::string active = ActivePreset(profile_);
+  recommended_->SetChecked(active == aerium_presets::kRecommended);
+  privacy_->SetChecked(active == aerium_presets::kPrivacy);
+  performance_->SetChecked(active == aerium_presets::kPerformance);
+  custom_note_->SetVisible(active == aerium_presets::kCustom);
+}
+
+BEGIN_METADATA(AeriumGuardBubbleView)
+END_METADATA
+
+AeriumGuardIconView::AeriumGuardIconView(
+    Profile* profile,
+    IconLabelBubbleView::Delegate* icon_label_bubble_delegate,
+    PageActionIconView::Delegate* page_action_icon_delegate)
+    : PageActionIconView(/*command_updater=*/nullptr,
+                         /*command_id=*/0,
+                         icon_label_bubble_delegate,
+                         page_action_icon_delegate,
+                         /*name_for_histograms=*/"AeriumGuard",
+                         /*action_id=*/std::nullopt,
+                         /*browser=*/nullptr,
+                         /*ephemeral=*/false),
+      profile_(PrefProfile(profile)) {
+  auto notify = base::BindRepeating(&AeriumGuardIconView::OnPresetPrefChanged,
+                                    base::Unretained(this));
+  if (PrefService* profile_prefs = ProfilePrefsOf(profile_)) {
+    profile_registrar_.Init(profile_prefs);
+    profile_registrar_.AddMultiple({aerium_presets::kDoNotTrack,
+                                    aerium_presets::kCookieControlsMode,
+                                    aerium_presets::kNetworkPredictionOptions,
+                                    aerium_presets::kClearDataOnExit,
+                                    aerium_presets::kSearchSuggestEnabled,
+                                    aerium_presets::kHttpsOnlyMode,
+                                    aerium_presets::kHttpsFirstBalancedMode,
+                                    aerium_presets::kWebRtcIpHandlingPolicy,
+                                    aerium_presets::kHyperlinkAuditing,
+                                    aerium_presets::kAlternateErrorPages,
+                                    aerium_presets::kCanMakePayment},
+                                   notify);
+  }
+  if (PrefService* local_state = LocalState()) {
+    local_state_registrar_.Init(local_state);
+    local_state_registrar_.AddMultiple(
+        {aerium_presets::kMemorySaverModeState,
+         aerium_presets::kMemorySaverAggressiveness,
+         aerium_presets::kBatterySaverModeState,
+         aerium_presets::kBackgroundModeEnabled},
+        notify);
+  }
+  GetViewAccessibility().SetName(GetTextForTooltipAndAccessibleName());
+}
+
+AeriumGuardIconView::~AeriumGuardIconView() {
+  if (bubble_widget_) {
+    bubble_widget_->RemoveObserver(this);
+  }
+}
+
+void AeriumGuardIconView::OnWidgetDestroying(views::Widget* widget) {
+  widget->RemoveObserver(this);
+  bubble_widget_ = nullptr;
+  bubble_ = nullptr;
+  // The tooltip is suppressed while the bubble is up; put it back now that it
+  // is not.
+  UpdateTooltipText();
+}
+
+void AeriumGuardIconView::UpdateImpl() {
+  // Always shown, unlike a page action: a mode is always in force, so there is
+  // always something to say. The delegate still gets to hide it while the user
+  // is typing in the omnibox, which is what keeps it in step with the icons
+  // next to it.
+  SetVisible(!delegate()->ShouldHidePageActionIcon(this));
+}
+
+void AeriumGuardIconView::OnExecuting(
+    PageActionIconView::ExecuteSource execute_source) {
+  if (bubble_) {
+    return;
+  }
+  auto bubble = std::make_unique<AeriumGuardBubbleView>(
+      this, delegate()->GetWebContentsForPageActionIconView(), profile_);
+  bubble_ = bubble.get();
+  // The Widget is what gets observed: PageActionIconView already inherits
+  // views::ViewObserver through AnimationDelegateViews, which declares
+  // OnViewIsDeleting() final, so this class cannot be a ViewObserver of its
+  // own. The bubble delegate is destroyed with its Widget either way.
+  bubble_widget_ =
+      views::BubbleDialogDelegateView::CreateBubble(std::move(bubble));
+  bubble_widget_->AddObserver(this);
+  bubble_widget_->Show();
+}
+
+views::BubbleDialogDelegate* AeriumGuardIconView::GetBubble() const {
+  return bubble_.get();
+}
+
+const gfx::VectorIcon& AeriumGuardIconView::GetVectorIcon() const {
+  return vector_icons::kShieldIcon;
+}
+
+std::u16string AeriumGuardIconView::GetTextForTooltipAndAccessibleName() const {
+  return l10n_util::GetStringFUTF16(
+      IDS_SETTINGS_AERIUM_GUARD_ICON_TOOLTIP,
+      l10n_util::GetStringUTF16(ModeLabelId(ActivePreset(profile_))));
+}
+
+void AeriumGuardIconView::OnPresetPrefChanged() {
+  GetViewAccessibility().SetName(GetTextForTooltipAndAccessibleName());
+  UpdateTooltipText();
+}
+
+BEGIN_METADATA(AeriumGuardIconView)
+END_METADATA
