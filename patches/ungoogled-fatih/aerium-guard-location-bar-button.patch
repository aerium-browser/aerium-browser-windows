+#ifndef CHROME_BROWSER_UI_VIEWS_LOCATION_BAR_AERIUM_GUARD_ICON_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_LOCATION_BAR_AERIUM_GUARD_ICON_VIEW_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/views/page_action/page_action_icon_view.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/widget/widget_observer.h"
+
+class AeriumGuardBubbleView;
+class Profile;
+
+namespace gfx {
+struct VectorIcon;
+}
+
+namespace views {
+class BubbleDialogDelegate;
+class Widget;
+}
+
+// The Aerium Guard button in the address bar.
+//
+// It is a shortcut to the three setup modes that chrome://settings/aeriumGuard
+// offers: clicking it opens a small bubble that names the mode currently in
+// force and lets the user switch to another one, without going to Settings.
+// Both places apply the same definitions from
+// chrome/browser/ui/webui/aerium_presets.h, so neither can drift from the
+// other.
+//
+// Unlike every other icon in this directory, this one is not registered with
+// PageActionIconController and has no PageActionIconType. That is deliberate:
+//
+//   - the controller's icons are page actions - they say something about the
+//     page in the current tab, and the framework's whole model (per-tab
+//     PageActionController, ephemeral visibility, CTR histograms keyed by
+//     PageActionIconType) is built around that. This button says nothing about
+//     the page: it is browser-wide and always shown, exactly like Brave's
+//     shield button;
+//   - a new PageActionIconType would have to be threaded through
+//     IsPageActionMigrated(), the properties provider and the page-action
+//     histogram enums, which is a lot of surface to disturb for a button that
+//     needs none of it.
+//
+// It still derives from PageActionIconView because that is what gives an
+// address-bar icon its size, insets, ink drop, focus behaviour and bubble
+// anchoring; LocationBarView owns it directly, lays it out as one more trailing
+// decoration and drives its Update() alongside the real page actions, which is
+// what makes it disappear while the user is typing in the omnibox like the
+// others do.
+class AeriumGuardIconView : public PageActionIconView,
+                            public views::WidgetObserver {
+  METADATA_HEADER(AeriumGuardIconView, PageActionIconView)
+
+ public:
+  AeriumGuardIconView(Profile* profile,
+                      IconLabelBubbleView::Delegate* icon_label_bubble_delegate,
+                      PageActionIconView::Delegate* page_action_icon_delegate);
+  AeriumGuardIconView(const AeriumGuardIconView&) = delete;
+  AeriumGuardIconView& operator=(const AeriumGuardIconView&) = delete;
+  ~AeriumGuardIconView() override;
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ protected:
+  // PageActionIconView:
+  void UpdateImpl() override;
+  void OnExecuting(PageActionIconView::ExecuteSource execute_source) override;
+  views::BubbleDialogDelegate* GetBubble() const override;
+  const gfx::VectorIcon& GetVectorIcon() const override;
+  std::u16string GetTextForTooltipAndAccessibleName() const override;
+
+ private:
+  // Re-reads the active mode and refreshes the tooltip. Bound to every pref a
+  // mode writes, so the tooltip is right even when the change came from
+  // somewhere else entirely - a settings page in another window, say.
+  void OnPresetPrefChanged();
+
+  // The profile whose prefs the modes are read from and written to. Always a
+  // regular profile: an off-the-record window shows and changes the modes of
+  // the profile it was opened from, which is what chrome://settings does too,
+  // rather than writing to an overlay that is thrown away on close.
+  const raw_ptr<Profile> profile_;
+
+  // Split the same way aerium_presets.h splits them: the eleven profile prefs
+  // on the profile's PrefService, the three performance prefs and
+  // background_mode.enabled on local state. Reaching for the wrong PrefService
+  // is a CHECK failure inside PrefService, not a silent no-op.
+  PrefChangeRegistrar profile_registrar_;
+  PrefChangeRegistrar local_state_registrar_;
+
+  // The open bubble and the Widget hosting it, or null. Both are cleared
+  // through WidgetObserver when the bubble goes away;
+  // PageActionIconView::IsBubbleShowing() reads GetBubble() to toggle the
+  // bubble shut when the button is clicked a second time.
+  //
+  // The Widget is observed rather than the View: PageActionIconView is
+  // already a views::ViewObserver by way of AnimationDelegateViews, which
+  // declares OnViewIsDeleting() final, so a second ViewObserver base is both
+  // ambiguous and impossible to override.
+  raw_ptr<AeriumGuardBubbleView> bubble_ = nullptr;
+  raw_ptr<views::Widget> bubble_widget_ = nullptr;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_LOCATION_BAR_AERIUM_GUARD_ICON_VIEW_H_
