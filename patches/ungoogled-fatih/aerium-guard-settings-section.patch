+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-aerium-guard-page' is the Aerium Guard section of chrome://settings.
+ * It is about modes, and nothing else: the same three setup modes the first-run
+ * screen offers - Recommended, Privacy and Performance.
+ *
+ * The individual settings a mode is a shortcut for stay where they already
+ * lived. The delete-on-exit block in particular belongs to Privacy and
+ * security and is hosted only there; showing the same pref-bound controls in
+ * two places gives the user two switches for one setting and no way to tell
+ * which one they last touched.
+ *
+ * The modes are not a pref, and this page deliberately does not know what any
+ * of them contains. Applying one and working out which one is currently in
+ * force both happen in the browser, in aerium_presets.h, which is also what the
+ * first-run screen applies - so the two cannot drift. All this page does is
+ * send a name and render the answer that comes back, including "Custom" when
+ * the current settings match no preset.
+ *
+ * It therefore hosts no writable controls and needs no PrefsMixin, which is
+ * why settings_main.html passes it no prefs.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import '../settings_page/settings_section.js';
+import '../settings_shared.css.js';
+
+import {WebUiListenerMixin} from 'chrome://resources/cr_elements/web_ui_listener_mixin.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {loadTimeData} from '../i18n_setup.js';
+import {getSearchManager} from '../search_settings.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+
+import {getTemplate} from './aerium_guard_page.html.js';
+
+interface GuardMode {
+  id: string;
+  label: string;
+  description: string;
+}
+
+const SettingsAeriumGuardPageElementBase = WebUiListenerMixin(PolymerElement);
+
+export class SettingsAeriumGuardPageElement extends
+    SettingsAeriumGuardPageElementBase implements SettingsPlugin {
+  static get is() {
+    return 'settings-aerium-guard-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      /**
+       * The preset the browser reports as currently in force, or 'custom'.
+       * Never assumed here - always whatever aerium_presets.h last said.
+       */
+      activePreset_: {
+        type: String,
+        value: 'custom',
+      },
+
+      modes_: {
+        type: Array,
+        value: () => [
+          {
+            id: 'recommended',
+            label: loadTimeData.getString('aeriumGuardRecommendedLabel'),
+            description: loadTimeData.getString('aeriumGuardRecommendedDesc'),
+          },
+          {
+            id: 'privacy',
+            label: loadTimeData.getString('aeriumGuardPrivacyLabel'),
+            description: loadTimeData.getString('aeriumGuardPrivacyDesc'),
+          },
+          {
+            id: 'performance',
+            label: loadTimeData.getString('aeriumGuardPerformanceLabel'),
+            description: loadTimeData.getString('aeriumGuardPerformanceDesc'),
+          },
+        ],
+      },
+    };
+  }
+
+  declare private activePreset_: string;
+  declare private modes_: GuardMode[];
+
+  override connectedCallback() {
+    super.connectedCallback();
+
+    this.addWebUiListener('aerium-guard-preset-changed', (preset: string) => {
+      this.activePreset_ = preset;
+    });
+    sendWithPromise<string>('aeriumGuardGetActivePreset').then(preset => {
+      this.activePreset_ = preset;
+    });
+  }
+
+  private isActive_(id: string, activePreset: string): boolean {
+    return id === activePreset;
+  }
+
+  private activeModeSummary_(activePreset: string): string {
+    const mode = this.modes_.find(m => m.id === activePreset);
+    return loadTimeData.getStringF(
+        'aeriumGuardActiveMode',
+        mode ? mode.label : loadTimeData.getString('aeriumGuardCustomLabel'));
+  }
+
+  private useModeAriaLabel_(label: string): string {
+    return loadTimeData.getStringF('aeriumGuardUseModeAriaLabel', label);
+  }
+
+  private onApplyClick_(e: Event) {
+    const preset = (e.currentTarget as HTMLElement).dataset['preset'];
+    if (preset === undefined) {
+      return;
+    }
+    chrome.send('aeriumGuardApplyPreset', [preset]);
+  }
+
+  // SettingsPlugin implementation
+  async searchContents(query: string) {
+    const searchRequest = await getSearchManager().search(query, this);
+    return searchRequest.getSearchResult();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-aerium-guard-page': SettingsAeriumGuardPageElement;
+  }
+}
+
+customElements.define(
+    SettingsAeriumGuardPageElement.is, SettingsAeriumGuardPageElement);
