+#ifndef CHROME_BROWSER_UI_WEBUI_AERIUM_PRESETS_H_
+#define CHROME_BROWSER_UI_WEBUI_AERIUM_PRESETS_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+#include "components/prefs/pref_service.h"
+
+// The one definition of Aerium's setup presets.
+//
+// Two places offer them - the first-run screen at chrome://aerium-first-run and
+// the Aerium Guard section of chrome://settings - and they must not drift, so
+// neither owns the lists. Both call in here: the first-run screen to apply what
+// the user picked, the settings page to apply it and to work out which preset
+// (if any) the current settings correspond to.
+//
+// Everything is header-only and inline, so adding this file needs no BUILD.gn
+// entry; the same reason ungoogled_first_run.h is a header.
+//
+// Pref paths are spelled out as strings rather than pulled in through a dozen
+// headers, and integer prefs use literal values with the enumerator named in a
+// comment. Every one was checked to exist and be registered at 151.0.7922.108:
+//
+//   enable_do_not_track                            bool, profile
+//       chrome/common/pref_names.h, registered in browser_ui_prefs.cc
+//   profile.cookie_controls_mode                   int, profile
+//       components/content_settings/core/common/pref_names.h, registered by
+//       content_settings::CookieSettings::RegisterProfilePrefs.
+//       CookieControlsMode: kOff=0, kBlockThirdParty=1, kIncognitoOnly=2
+//   net.network_prediction_options                 int, profile
+//       registered by prefetch::RegisterPredictionOptionsProfilePrefs.
+//       NetworkPredictionOptions: kStandard=0, kWifiOnlyDeprecated=1,
+//       kDisabled=2, kExtended=3
+//   browser.clear_data.aerium_clear_on_exit        bool, profile
+//       added by aerium-clear-browsing-data-on-exit.patch, registered through
+//       browsing_data::prefs::RegisterBrowserUserPrefs
+//   search.suggest_enabled                         bool, profile
+//   performance_tuning.high_efficiency_mode.state  int, LOCAL STATE
+//       MemorySaverModeState: kDisabled=0, kDeprecated=1, kEnabled=2
+//   performance_tuning.battery_saver_mode.state    int, LOCAL STATE
+//       BatterySaverModeState: kDisabled=0, kEnabledBelowThreshold=1,
+//       kEnabledOnBattery=2, kEnabled=3
+//
+// The two performance prefs are browser-wide, not per profile - they come from
+// RegisterLocalStatePrefs, not RegisterProfilePrefs - so they are read from and
+// written to g_browser_process->local_state().
+namespace aerium_presets {
+
+// Preset names, as they travel over chrome.send() and appear in the UI.
+inline constexpr char kRecommended[] = "recommended";
+inline constexpr char kPrivacy[] = "privacy";
+inline constexpr char kPerformance[] = "performance";
+// Not a preset that can be applied: what DetectPreset() returns when the
+// current settings match none of the three.
+inline constexpr char kCustom[] = "custom";
+
+// Profile prefs a preset writes.
+inline constexpr char kDoNotTrack[] = "enable_do_not_track";
+inline constexpr char kCookieControlsMode[] = "profile.cookie_controls_mode";
+inline constexpr char kNetworkPredictionOptions[] =
+    "net.network_prediction_options";
+inline constexpr char kClearDataOnExit[] =
+    "browser.clear_data.aerium_clear_on_exit";
+inline constexpr char kSearchSuggestEnabled[] = "search.suggest_enabled";
+
+// Local-state prefs a preset writes.
+inline constexpr char kMemorySaverModeState[] =
+    "performance_tuning.high_efficiency_mode.state";
+inline constexpr char kBatterySaverModeState[] =
+    "performance_tuning.battery_saver_mode.state";
+// flags_ui::prefs::kAboutFlagsEntries - the list about_flags reads at startup.
+inline constexpr char kAboutFlagsEntries[] = "browser.enabled_labs_experiments";
+
+// What a preset sets each pref to.
+struct PresetValues {
+  bool do_not_track;
+  int cookie_controls_mode;
+  int network_prediction_options;
+  bool clear_data_on_exit;
+  bool search_suggest_enabled;
+  int memory_saver_mode_state;
+  int battery_saver_mode_state;
+};
+
+inline bool IsApplicablePreset(std::string_view preset) {
+  return preset == kRecommended || preset == kPrivacy ||
+         preset == kPerformance;
+}
+
+// All three presets share a privacy floor - Do Not Track, third-party cookies
+// blocked, Memory Saver on - and differ only in what they trade away.
+//
+//   Recommended keeps page preloading off and search suggestions on, and leaves
+//   Battery Saver on battery power. It is deliberately the boring one: nothing
+//   in it should ever make a site misbehave.
+//
+//   Privacy adds delete-on-exit and turns search suggestions off, so nothing
+//   typed in the address bar leaves the browser at all.
+//
+//   Performance turns page preloading on (kStandard) and switches Battery Saver
+//   off so nothing is throttled when unplugged. Memory Saver stays on:
+//   releasing idle tabs helps responsiveness rather than hurting it. The
+//   privacy floor is unchanged - none of it costs measurable speed.
+inline std::optional<PresetValues> GetPresetValues(std::string_view preset) {
+  if (!IsApplicablePreset(preset)) {
+    return std::nullopt;
+  }
+  const bool privacy = preset == kPrivacy;
+  const bool performance = preset == kPerformance;
+
+  PresetValues values;
+  values.do_not_track = true;
+  // content_settings::CookieControlsMode::kBlockThirdParty.
+  values.cookie_controls_mode = 1;
+  // prefetch::NetworkPredictionOptions: kStandard = 0, kDisabled = 2.
+  values.network_prediction_options = performance ? 0 : 2;
+  values.clear_data_on_exit = privacy;
+  values.search_suggest_enabled = !privacy;
+  // performance_manager MemorySaverModeState::kEnabled = 2.
+  values.memory_saver_mode_state = 2;
+  // BatterySaverModeState: kDisabled = 0, kEnabledOnBattery = 2.
+  values.battery_saver_mode_state = performance ? 0 : 2;
+  return values;
+}
+
+// chrome://flags entries a preset switches on. Entry syntax follows
+// FeatureEntry::NameForOption(): a SINGLE_VALUE_TYPE entry is stored under its
+// bare internal name, a FEATURE_VALUE_TYPE entry has three options and "@1"
+// means Enabled. Each flag was confirmed to exist at this revision.
+inline std::vector<std::string> GetPresetFlags(std::string_view preset) {
+  std::vector<std::string> flags;
+  if (!IsApplicablePreset(preset)) {
+    return flags;
+  }
+  flags.push_back("disable-search-engine-collection");  // SINGLE_VALUE, ungoogled
+  flags.push_back("remove-client-hints@1");             // FEATURE_VALUE, ungoogled
+  if (preset == kPrivacy) {
+    flags.push_back("fingerprinting-canvas-image-data-noise");  // bromite
+    flags.push_back("fingerprinting-canvas-measuretext-noise");  // bromite
+    flags.push_back("fingerprinting-client-rects-noise");        // bromite
+    flags.push_back("force-punycode-hostnames");                 // ungoogled
+    flags.push_back("reduced-system-info@1");                    // ungoogled
+    flags.push_back("increase-incognito-storage-quota@1");       // ungoogled
+  }
+  if (preset == kPerformance) {
+    flags.push_back("enable-parallel-downloading@1");  // upstream about_flags
+  }
+  return flags;
+}
+
+// Adds entries to the local-state list about_flags reads at startup, leaving
+// anything already in it (including the seed from default-flags.patch) alone,
+// so applying a preset never clobbers a hand-set flag.
+inline void SeedFlags(PrefService* local_state,
+                      const std::vector<std::string>& entries) {
+  base::ListValue list = local_state->GetList(kAboutFlagsEntries).Clone();
+  for (const std::string& entry : entries) {
+    if (!list.contains(entry)) {
+      list.Append(entry);
+    }
+  }
+  local_state->SetList(kAboutFlagsEntries, std::move(list));
+}
+
+// Writes a preset. Returns false and touches nothing for an unknown name or a
+// missing PrefService. Flags only take effect after a restart, unlike the
+// prefs; callers say so in their UI.
+inline bool ApplyPreset(std::string_view preset,
+                        PrefService* profile_prefs,
+                        PrefService* local_state) {
+  const std::optional<PresetValues> values = GetPresetValues(preset);
+  if (!values.has_value() || !profile_prefs || !local_state) {
+    return false;
+  }
+
+  profile_prefs->SetBoolean(kDoNotTrack, values->do_not_track);
+  profile_prefs->SetInteger(kCookieControlsMode, values->cookie_controls_mode);
+  profile_prefs->SetInteger(kNetworkPredictionOptions,
+                            values->network_prediction_options);
+  profile_prefs->SetBoolean(kClearDataOnExit, values->clear_data_on_exit);
+  profile_prefs->SetBoolean(kSearchSuggestEnabled,
+                            values->search_suggest_enabled);
+
+  local_state->SetInteger(kMemorySaverModeState,
+                          values->memory_saver_mode_state);
+  local_state->SetInteger(kBatterySaverModeState,
+                          values->battery_saver_mode_state);
+
+  SeedFlags(local_state, GetPresetFlags(preset));
+  return true;
+}
+
+// Returns the preset the current settings correspond to, or kCustom when they
+// match none of them - which is the honest answer as soon as the user changes
+// any one of these settings by hand, and is what the Aerium Guard page shows.
+//
+// Only the prefs are compared, not the chrome://flags entries. SeedFlags() only
+// ever adds entries and never removes one, precisely so that a preset cannot
+// undo a flag the user set deliberately; the consequence is that flags left
+// over from a previously applied preset say nothing about which preset is in
+// force now, so including them would make detection wrong rather than stricter.
+inline std::string DetectPreset(const PrefService* profile_prefs,
+                                const PrefService* local_state) {
+  if (!profile_prefs || !local_state) {
+    return kCustom;
+  }
+  for (const char* preset : {kRecommended, kPrivacy, kPerformance}) {
+    const PresetValues values = *GetPresetValues(preset);
+    if (profile_prefs->GetBoolean(kDoNotTrack) == values.do_not_track &&
+        profile_prefs->GetInteger(kCookieControlsMode) ==
+            values.cookie_controls_mode &&
+        profile_prefs->GetInteger(kNetworkPredictionOptions) ==
+            values.network_prediction_options &&
+        profile_prefs->GetBoolean(kClearDataOnExit) ==
+            values.clear_data_on_exit &&
+        profile_prefs->GetBoolean(kSearchSuggestEnabled) ==
+            values.search_suggest_enabled &&
+        local_state->GetInteger(kMemorySaverModeState) ==
+            values.memory_saver_mode_state &&
+        local_state->GetInteger(kBatterySaverModeState) ==
+            values.battery_saver_mode_state) {
+      return preset;
+    }
+  }
+  return kCustom;
+}
+
+}  // namespace aerium_presets
+
