+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_AERIUM_GUARD_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_AERIUM_GUARD_HANDLER_H_
+
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui/aerium_presets.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_ui.h"
+
+namespace settings {
+
+// Backs the Aerium Guard section of chrome://settings.
+//
+// The individual prefs on that page are ordinary settingsPrivate prefs and need
+// no handler. This exists for the mode presets, which are not a pref: applying
+// one writes seven prefs plus a set of chrome://flags entries, and
+// browser.enabled_labs_experiments is local state that has no business being
+// exposed to the settings WebUI. Both applying and detecting therefore happen
+// in the browser, against aerium_presets.h - the same definitions the first-run
+// screen applies, so the two cannot drift.
+//
+// Header-only for the same reason ungoogled_first_run.h is: it needs no
+// BUILD.gn entry.
+class AeriumGuardHandler : public SettingsPageUIHandler {
+ public:
+  explicit AeriumGuardHandler(Profile* profile) : profile_(profile) {}
+
+  AeriumGuardHandler(const AeriumGuardHandler&) = delete;
+  AeriumGuardHandler& operator=(const AeriumGuardHandler&) = delete;
+
+  ~AeriumGuardHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "aeriumGuardGetActivePreset",
+        base::BindRepeating(&AeriumGuardHandler::HandleGetActivePreset,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "aeriumGuardApplyPreset",
+        base::BindRepeating(&AeriumGuardHandler::HandleApplyPreset,
+                            base::Unretained(this)));
+  }
+
+ private:
+  // The page shows which preset is in force, so it has to be told when that
+  // changes - including when it changes because the user edited one of these
+  // settings somewhere else entirely, which is exactly when the answer becomes
+  // "Custom". Observing the prefs here rather than in TypeScript keeps the list
+  // of prefs a preset covers in one place.
+  void OnJavascriptAllowed() override {
+    auto notify = base::BindRepeating(&AeriumGuardHandler::NotifyPresetChanged,
+                                      base::Unretained(this));
+    profile_registrar_.Init(profile_->GetPrefs());
+    profile_registrar_.AddMultiple({aerium_presets::kDoNotTrack,
+                                    aerium_presets::kCookieControlsMode,
+                                    aerium_presets::kNetworkPredictionOptions,
+                                    aerium_presets::kClearDataOnExit,
+                                    aerium_presets::kSearchSuggestEnabled},
+                                   notify);
+    if (PrefService* local_state = g_browser_process->local_state()) {
+      local_state_registrar_.Init(local_state);
+      local_state_registrar_.AddMultiple(
+          {aerium_presets::kMemorySaverModeState,
+           aerium_presets::kBatterySaverModeState},
+          notify);
+    }
+  }
+
+  void OnJavascriptDisallowed() override {
+    profile_registrar_.RemoveAll();
+    local_state_registrar_.RemoveAll();
+  }
+
+  std::string ActivePreset() const {
+    return aerium_presets::DetectPreset(profile_->GetPrefs(),
+                                        g_browser_process->local_state());
+  }
+
+  void NotifyPresetChanged() {
+    FireWebUIListener("aerium-guard-preset-changed",
+                      base::Value(ActivePreset()));
+  }
+
+  void HandleGetActivePreset(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() != 1) {
+      return;
+    }
+    ResolveJavascriptCallback(args[0], base::Value(ActivePreset()));
+  }
+
+  void HandleApplyPreset(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() != 1 || !args[0].is_string()) {
+      return;
+    }
+    aerium_presets::ApplyPreset(args[0].GetString(), profile_->GetPrefs(),
+                                g_browser_process->local_state());
+    // The pref observers above will normally have fired already; this covers
+    // the case where the preset was applied on top of itself and nothing
+    // actually changed, so the page still gets an answer.
+    NotifyPresetChanged();
+  }
+
+  const raw_ptr<Profile> profile_;
+  PrefChangeRegistrar profile_registrar_;
+  PrefChangeRegistrar local_state_registrar_;
+};
+
+}  // namespace settings
