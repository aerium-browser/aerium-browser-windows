+   add.append(f, l);
+   add.addEventListener('click', () => { dlg.showModal(); document.getElementById('n').focus(); });
+   grid.append(add);
+ }
+
+ // Called by the controller.
+ window.aeriumNewTabSettings = raw => {
+   try {
+     const v = JSON.parse(raw || '{}');
+     if (v && typeof v === 'object') cfg = Object.assign(cfg, v);
+   } catch (e) { /* defaults stand */ }
+   applyCfg(); syncPanel();
+ };
+
+ window.aeriumNewTabTiles = raw => {
+   try { const v = JSON.parse(raw || '[]'); tiles = Array.isArray(v) ? v : []; }
+   catch (e) { tiles = []; }
+   render();
+ };
+
+ function syncPanel(){
+   document.querySelectorAll('#bgChips .chip').forEach(c =>
+       c.setAttribute('aria-pressed', String(c.dataset.bg === cfg.bg)));
+   document.querySelectorAll('#colChips .chip').forEach(c =>
+       c.setAttribute('aria-pressed', String(Number(c.dataset.cols) === cfg.cols)));
+   document.getElementById('rowChip').setAttribute('aria-pressed', String(!!cfg.row));
+
+   const sets = document.getElementById('setChips');
+   const sws = document.getElementById('swatches');
+   const showSets = cfg.bg === 'photo';
+   sets.style.display = showSets ? 'flex' : 'none';
+   sws.style.display = showSets ? 'flex' : 'none';
+   if (!showSets) return;
+   sets.textContent = ''; sws.textContent = '';
+   Object.keys(SETS).forEach(k => {
+     const b = document.createElement('button');
+     b.className = 'chip'; b.textContent = SET_NAMES[k];
+     b.setAttribute('aria-pressed', String(k === cfg.set));
+     b.addEventListener('click', () => { cfg.set = k; saveCfg(); applyCfg(); syncPanel(); });
+     sets.append(b);
+   });
+   (SETS[cfg.set] || SETS.dusk).forEach(g => {
+     const d = document.createElement('div');
+     d.className = 'sw'; d.style.background = g; d.style.backgroundSize = 'cover';
+     sws.append(d);
+   });
+ }
+
+ document.getElementById('gear').addEventListener('click', () => {
+   syncPanel(); panel.showModal();
+ });
+ document.getElementById('cfgDone').addEventListener('click', () => panel.close());
+ document.getElementById('cfgClear').addEventListener('click', () => {
+   tiles = []; save(); render();
+ });
+ document.getElementById('bgChips').addEventListener('click', e => {
+   const b = e.target.closest('.chip'); if (!b) return;
+   cfg.bg = b.dataset.bg; saveCfg(); applyCfg(); syncPanel();
+ });
+ document.getElementById('colChips').addEventListener('click', e => {
+   const b = e.target.closest('.chip'); if (!b) return;
+   cfg.cols = Number(b.dataset.cols); saveCfg(); applyCfg(); syncPanel();
+ });
+ document.getElementById('rowChip').addEventListener('click', () => {
+   cfg.row = !cfg.row; saveCfg(); applyCfg(); syncPanel();
+ });
+
+ document.getElementById('cancel').addEventListener('click', () => dlg.close());
+ document.getElementById('ok').addEventListener('click', () => {
+   let u = document.getElementById('u').value.trim();
+   if (!u) return;
+   if (!u.includes('://')) u = 'https://' + u;
+   let parsed;
+   try { parsed = new URL(u); } catch (e) { return; }
+   if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return;
+   tiles.push({ title: document.getElementById('n').value.trim(), url: u });
+   document.getElementById('n').value = '';
+   document.getElementById('u').value = '';
+   dlg.close(); save(); render();
+ });
+
+ applyCfg();
+ render();
+ chrome.send('aeriumNewTabGetSettings');
+ chrome.send('aeriumNewTabGetTiles');
+</script>
+)";
+    std::move(callback).Run(
+        base::MakeRefCounted<base::RefCountedString>(std::string(kPage)));
+  }
+};
