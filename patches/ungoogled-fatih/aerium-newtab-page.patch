+class AeriumNewTabUIConfig : public content::DefaultWebUIConfig<AeriumNewTab> {
+ public:
+  AeriumNewTabUIConfig() : DefaultWebUIConfig("chrome", "aerium-newtab") {}
+};
+
+class AeriumNewTab : public content::WebUIController {
+ public:
+  explicit AeriumNewTab(content::WebUI* web_ui)
+      : content::WebUIController(web_ui) {
+    Profile* profile = Profile::FromWebUI(web_ui);
+    content::URLDataSource::Add(profile,
+                                std::make_unique<AeriumNewTabDataSource>());
+    web_ui->RegisterMessageCallback(
+        "aeriumNewTabGetTiles",
+        base::BindRepeating(&AeriumNewTab::HandleGetTiles,
+                            base::Unretained(this)));
+    web_ui->RegisterMessageCallback(
+        "aeriumNewTabSetTiles",
+        base::BindRepeating(&AeriumNewTab::HandleSetTiles,
+                            base::Unretained(this)));
+    web_ui->RegisterMessageCallback(
+        "aeriumNewTabGetSettings",
+        base::BindRepeating(&AeriumNewTab::HandleGetSettings,
+                            base::Unretained(this)));
+    web_ui->RegisterMessageCallback(
+        "aeriumNewTabSetSettings",
+        base::BindRepeating(&AeriumNewTab::HandleSetSettings,
+                            base::Unretained(this)));
+  }
+  AeriumNewTab(const AeriumNewTab&) = delete;
+  AeriumNewTab& operator=(const AeriumNewTab&) = delete;
+
+ private:
+  PrefService* prefs() { return Profile::FromWebUI(web_ui())->GetPrefs(); }
+
+  // base::ListValue, not base::Value::List. content/public/browser/web_ui.h in
+  // this tree declares MessageCallback as
+  // RepeatingCallback<void(const base::ListValue&)>, and base::ListValue is a
+  // top-level class in base/values.h here rather than a nested Value::List.
+  // The element API is the same - empty(), size(), operator[] - so only the
+  // parameter type differs from what upstream Chromium documents elsewhere.
+  void HandleGetTiles(const base::ListValue& args) {
+    web_ui()->CallJavascriptFunctionUnsafe(
+        "aeriumNewTabTiles",
+        base::Value(prefs()->GetString(kAeriumNewTabTilesPref)));
+  }
+
+  // The page is the only writer and it sends what it just rendered, so this
+  // stores the string as given. It is read back by the page alone and parsed
+  // there inside a try, so a value hand-edited into nonsense costs an empty
+  // grid rather than anything worse.
+  void HandleSetTiles(const base::ListValue& args) {
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    prefs()->SetString(kAeriumNewTabTilesPref, args[0].GetString());
+  }
+
+  // Settings ride in one JSON string for the same reason the shortcuts do: the
+  // page is the only thing that reads or writes them, so a pref per checkbox
+  // would be four more registrations and four more handlers to say the same
+  // thing. An unparsable value falls back to the defaults in the page.
+  void HandleGetSettings(const base::ListValue& args) {
+    web_ui()->CallJavascriptFunctionUnsafe(
+        "aeriumNewTabSettings",
+        base::Value(prefs()->GetString(kAeriumNewTabSettingsPref)));
+  }
+
+  void HandleSetSettings(const base::ListValue& args) {
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    prefs()->SetString(kAeriumNewTabSettingsPref, args[0].GetString());
+  }
+};
