   if (base::CommandLine::ForCurrentProcess()->HasSwitch("custom-ntp"))
     ntp_location = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("custom-ntp");
   if (profile->IsOffTheRecord() && ntp_location.find("chrome://") != std::string::npos) return false;
+  // Aerium: fall back to our own new tab page when nothing else has claimed
+  // the slot. Checked after the pref rather than before it, so an enterprise
+  // NewTabPageLocation policy - and ungoogled-chromium's --custom-ntp flag
+  // handled above - both still win; this only fills an empty answer. The pref
