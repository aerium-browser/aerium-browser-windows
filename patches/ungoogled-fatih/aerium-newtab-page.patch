+// chrome://aerium-newtab - the Aerium new tab page.
+//
+// The same speed dial the Android build draws in native views, as a page,
+// because on desktop the new tab page is a page whatever we do: there is no
+// version of this that avoids a renderer, so the argument that made native
+// views right on Android does not apply here.
+//
+// Header-only, matching aerium_patches.h next to it - a DefaultWebUIConfig plus
+// an inline URLDataSource needs no BUILD.gn entry, no .cc and no TypeScript.
+//
+// Shortcuts live in a profile pref rather than in the page. localStorage on a
+// chrome:// origin would have been less code and was not used: it is not a
+// promise this project has checked, and a speed dial that silently forgets
+// itself is worse than one that took twenty more lines.
+//
+// No search box, deliberately. On Android the address bar can be at the bottom
+// and the new tab page is the only reliable place to start typing; on desktop
+// the omnibox is on screen already, and a second search field that cannot focus
+// the first without a mojo round trip is decoration.
+
+inline constexpr char kAeriumNewTabPagePref[] = "aerium.new_tab_page";
+inline constexpr char kAeriumNewTabTilesPref[] = "aerium.new_tab_page.tiles";
+
+class AeriumNewTabDataSource : public content::URLDataSource {
+ public:
+  AeriumNewTabDataSource() = default;
+  AeriumNewTabDataSource(const AeriumNewTabDataSource&) = delete;
+  AeriumNewTabDataSource& operator=(const AeriumNewTabDataSource&) = delete;
+  ~AeriumNewTabDataSource() override = default;
+
+  std::string GetSource() override { return "aerium-newtab"; }
+  std::string GetMimeType(const GURL& url) override { return "text/html"; }
+
+  // The page carries one inline script. The default policy for a URLDataSource
+  // forbids inline script, so script-src is relaxed for this host only and
+  // every other directive is left to the default implementation.
+  std::string GetContentSecurityPolicy(
+      network::mojom::CSPDirectiveName directive) override {
+    if (directive == network::mojom::CSPDirectiveName::ScriptSrc) {
+      return "script-src 'self' 'unsafe-inline';";
+    }
+    return content::URLDataSource::GetContentSecurityPolicy(directive);
+  }
+
+  void StartDataRequest(const GURL& url,
+                        const content::WebContents::Getter& wc_getter,
+                        GotDataCallback callback) override {
+    static constexpr char kPage[] = R"(<!doctype html>
+<meta charset="utf-8">
+<title>New tab</title>
+<style>
+ :root{--bg:#000;--outline:#22376E;--outline-dim:#1B2A57;--accent:#7FC4E4;
+       --label:#8FA3C4;--label-dim:#5B7099;--text:#D8E6F5}
+ @media(prefers-color-scheme:light){
+  :root{--bg:#F2F7FD;--outline:#D8E6F5;--outline-dim:#E1ECF9;--accent:#2C6BAE;
+        --label:#4A5D7A;--label-dim:#8095B3;--text:#0B2138}
+ }
+ html{background:var(--bg);color:var(--text);
+      font:14px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
+ body{margin:0;min-height:100vh;display:flex;flex-direction:column;
+      align-items:center;justify-content:center;padding:48px 24px}
+ main{width:100%;max-width:640px}
+ #grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));
+       gap:26px 16px;margin:0 0 44px}
+ .cell{display:flex;flex-direction:column;align-items:center;gap:9px;
+       text-decoration:none;color:inherit;cursor:pointer;position:relative}
+ .face{width:64px;height:64px;border-radius:20px;border:1px solid var(--outline);
+       display:flex;align-items:center;justify-content:center;
+       font-size:24px;font-weight:600;color:var(--accent)}
+ .cell.add .face{border-style:dashed;border-color:var(--outline-dim);
+                 color:var(--label-dim);font-weight:400}
+ .label{font-size:12px;color:var(--label);text-align:center;
+        overflow-wrap:anywhere;max-width:100%}
+ .cell.add .label{color:var(--label-dim)}
+ .x{position:absolute;top:-6px;right:calc(50% - 40px);width:22px;height:22px;
+    border-radius:11px;background:var(--accent);color:var(--bg);border:0;
+    font:600 13px/1 system-ui;cursor:pointer;display:none}
+ body.editing .x{display:block}
+ #row{display:flex;gap:12px}
+ #row a{flex:1;height:46px;border-radius:14px;border:1px solid var(--outline);
+        display:flex;align-items:center;justify-content:center;
+        text-decoration:none;color:var(--text);font-size:13px}
+ #row a:hover,.face:hover{border-color:var(--accent)}
+ dialog{background:var(--bg);color:var(--text);border:1px solid var(--outline);
+        border-radius:16px;padding:22px;min-width:320px}
+ dialog h2{margin:0 0 16px;font-size:17px;font-weight:600}
+ dialog input{width:100%;box-sizing:border-box;margin:0 0 12px;height:44px;
+              padding:0 12px;border-radius:10px;border:1px solid var(--outline);
+              background:transparent;color:var(--text);font:inherit}
+ dialog .buttons{display:flex;gap:10px;justify-content:flex-end;margin-top:6px}
+ dialog button{height:40px;padding:0 18px;border-radius:12px;font:600 13px system-ui;
+               cursor:pointer;border:1px solid var(--outline);
+               background:transparent;color:var(--label)}
+ dialog button.primary{background:var(--accent);color:var(--bg);border-color:var(--accent)}
+</style>
+<main>
+  <div id="grid"></div>
+  <div id="row">
+    <a href="chrome://bookmarks/">Bookmarks</a>
+    <a href="chrome://history/">History</a>
+    <a href="chrome://downloads/">Downloads</a>
+  </div>
+</main>
+<dialog id="dlg">
+  <h2>Add a shortcut</h2>
+  <input id="n" placeholder="Name" autocomplete="off">
+  <input id="u" placeholder="Address" autocomplete="off">
+  <div class="buttons">
+    <button id="cancel">Cancel</button>
+    <button id="ok" class="primary">Add</button>
+  </div>
+</dialog>
+<script>
+ let tiles = [];
+ const grid = document.getElementById('grid');
+ const dlg = document.getElementById('dlg');
+
+ function host(u){ try { return new URL(u).hostname.replace(/^www\./,''); } catch(e){ return ''; } }
+ function mono(t){ const s = t.title || host(t.url); return s ? s[0].toUpperCase() : '?'; }
+ function name(t){ return t.title || host(t.url) || t.url; }
+
+ function save(){ chrome.send('aeriumNewTabSetTiles', [JSON.stringify(tiles)]); }
+
+ function render(){
+   grid.textContent = '';
+   tiles.forEach((t, i) => {
+     const a = document.createElement('a');
+     a.className = 'cell'; a.href = t.url;
+     const f = document.createElement('div'); f.className = 'face'; f.textContent = mono(t);
+     const l = document.createElement('div'); l.className = 'label'; l.textContent = name(t);
+     const x = document.createElement('button'); x.className = 'x'; x.textContent = '×';
+     x.addEventListener('click', e => {
+       e.preventDefault(); e.stopPropagation();
+       tiles.splice(i, 1); save(); render();
+     });
+     a.append(f, l, x);
+     a.addEventListener('contextmenu', e => {
+       e.preventDefault(); document.body.classList.toggle('editing');
+     });
+     grid.append(a);
+   });
+   const add = document.createElement('div');
+   add.className = 'cell add'; add.tabIndex = 0;
+   const f = document.createElement('div'); f.className = 'face'; f.textContent = '+';
+   const l = document.createElement('div'); l.className = 'label'; l.textContent = 'Add';
+   add.append(f, l);
+   add.addEventListener('click', () => { dlg.showModal(); document.getElementById('n').focus(); });
+   grid.append(add);
+ }
+
+ // Called by the controller.
+ window.aeriumNewTabTiles = raw => {
+   try { const v = JSON.parse(raw || '[]'); tiles = Array.isArray(v) ? v : []; }
+   catch (e) { tiles = []; }
+   render();
+ };
+
+ document.getElementById('cancel').addEventListener('click', () => dlg.close());
+ document.getElementById('ok').addEventListener('click', () => {
+   let u = document.getElementById('u').value.trim();
+   if (!u) return;
+   if (!u.includes('://')) u = 'https://' + u;
+   let parsed;
+   try { parsed = new URL(u); } catch (e) { return; }
+   if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return;
+   tiles.push({ title: document.getElementById('n').value.trim(), url: u });
+   document.getElementById('n').value = '';
+   document.getElementById('u').value = '';
+   dlg.close(); save(); render();
+ });
+
+ render();
+ chrome.send('aeriumNewTabGetTiles');
+</script>
+)";
+    std::move(callback).Run(
+        base::MakeRefCounted<base::RefCountedString>(std::string(kPage)));
+  }
+};
+
+class AeriumNewTab;
+
+class AeriumNewTabUIConfig : public content::DefaultWebUIConfig<AeriumNewTab> {
+ public:
+  AeriumNewTabUIConfig() : DefaultWebUIConfig("chrome", "aerium-newtab") {}
+};
+
+class AeriumNewTab : public content::WebUIController {
+ public:
+  explicit AeriumNewTab(content::WebUI* web_ui)
+      : content::WebUIController(web_ui) {
+    Profile* profile = Profile::FromWebUI(web_ui);
+    content::URLDataSource::Add(profile,
+                                std::make_unique<AeriumNewTabDataSource>());
+    web_ui->RegisterMessageCallback(
+        "aeriumNewTabGetTiles",
+        base::BindRepeating(&AeriumNewTab::HandleGetTiles,
+                            base::Unretained(this)));
+    web_ui->RegisterMessageCallback(
+        "aeriumNewTabSetTiles",
+        base::BindRepeating(&AeriumNewTab::HandleSetTiles,
+                            base::Unretained(this)));
+  }
+  AeriumNewTab(const AeriumNewTab&) = delete;
+  AeriumNewTab& operator=(const AeriumNewTab&) = delete;
+
+ private:
+  PrefService* prefs() { return Profile::FromWebUI(web_ui())->GetPrefs(); }
+
+  void HandleGetTiles(const base::Value::List& args) {
+    web_ui()->CallJavascriptFunctionUnsafe(
+        "aeriumNewTabTiles",
+        base::Value(prefs()->GetString(kAeriumNewTabTilesPref)));
+  }
+
+  // The page is the only writer and it sends what it just rendered, so this
+  // stores the string as given. It is read back by the page alone and parsed
+  // there inside a try, so a value hand-edited into nonsense costs an empty
+  // grid rather than anything worse.
+  void HandleSetTiles(const base::Value::List& args) {
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    prefs()->SetString(kAeriumNewTabTilesPref, args[0].GetString());
+  }
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_AERIUM_NEWTAB_H_
