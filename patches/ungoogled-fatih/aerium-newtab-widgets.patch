+ // Stable for the day, so the page does not flicker between quotes on every
+ // reload, and changes across years rather than repeating on the same
+ // calendar day each time - the same rule AeriumNtpWidgets.java picks by.
+ function dayOfYear(d){
+   const start = new Date(d.getFullYear(), 0, 0);
+   return Math.floor((d - start) / 86400000);
+ }
+
+ function greetingWord(hour){
+   return hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
+ }
+
+ function renderWidgets(){
+   const now = new Date();
+   const wc = document.getElementById('wClock');
+   const wd = document.getElementById('wDate');
+   wc.hidden = wd.hidden = !cfg.clock;
+   if (cfg.clock) {
+     wc.textContent = now.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
+     wd.textContent = now.toLocaleDateString([], { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
+   }
+   const wg = document.getElementById('wGreeting');
+   wg.hidden = !cfg.greeting;
+   if (cfg.greeting) {
+     const base = greetingWord(now.getHours());
+     wg.textContent = cfg.name ? base + ', ' + cfg.name : base;
+   }
+   const wq = document.getElementById('wQuote');
+   const wa = document.getElementById('wAuthor');
+   wq.hidden = wa.hidden = !cfg.quote;
+   if (cfg.quote) {
+     const q = QUOTES[(dayOfYear(now) + now.getFullYear()) % QUOTES.length];
+     wq.textContent = '“' + q[0] + '”';
+     wa.textContent = '— ' + q[1];
+   }
+ }
