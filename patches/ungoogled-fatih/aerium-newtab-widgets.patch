+ // Stable for the day, so the page does not flicker between quotes on every
+ // reload, and changes across years rather than repeating on the same
+ // calendar day each time - the same rule AeriumNtpWidgets.java picks by.
+ function dayOfYear(d){
+   const start = new Date(d.getFullYear(), 0, 0);
+   return Math.floor((d - start) / 86400000);
+ }
+
+ function greetingWord(hour){
+   return hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
+ }
+
+ // Which entry in QUOTES is showing. Null until window.aeriumNewTabSettings
+ // sets it from the real, loaded cfg.quoteOffset - not here at declaration
+ // and not inside renderWidgets(), because applyCfg() (and so renderWidgets)
+ // runs on every settings-panel click, not only once per visit the way
+ // Android's rebuild() does. Resetting it there would mean a reshuffle
+ // surviving the 30-second tick only to be undone by clicking an unrelated
+ // chip like column count. Left null, renderQuote() below leaves the
+ // question open rather than guessing, and reshuffleQuote() falls back to
+ // today's pick the one time it is asked to advance from nothing.
+ let quoteIndex = null;
+
+ function dailyQuoteIndex(){
+   const now = new Date();
+   const sum = dayOfYear(now) + now.getFullYear() + (cfg.quoteOffset || 0);
+   return sum % QUOTES.length;
+ }
+
+ function renderQuote(){
+   const wq = document.getElementById('wQuote');
+   const wa = document.getElementById('wAuthor');
+   wq.hidden = wa.hidden = !cfg.quote;
+   if (!cfg.quote || quoteIndex === null) return;
+   const q = QUOTES[quoteIndex];
+   wq.textContent = '“' + q[0] + '”';
+   wa.textContent = '— ' + q[1];
