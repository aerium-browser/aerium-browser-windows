@@ -5104,6 +5132,12 @@ bool ChromeContentBrowserClient::
 
 void ChromeContentBrowserClient::BrowserURLHandlerCreated(
     BrowserURLHandler* handler) {
+  // Aerium: aerium://<host> is another spelling of chrome://<host>. First,
+  // ahead of every handler below, so that aerium://newtab and aerium://about
+  // reach the handlers that know what those mean.
+  handler->AddHandlerPair(&HandleAeriumScheme,
+                          BrowserURLHandler::null_handler());
