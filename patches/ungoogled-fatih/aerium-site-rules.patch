+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browsing_data/aerium_site_rules.h"
+
+#include <string_view>
+#include <utility>
+
+#include "base/strings/string_util.h"
+// base::DictValue, not base::Value::Dict: Chromium 151 promoted the nested
+// containers to top-level classes and deleted the aliases outright.
+#include "base/values.h"
+#include "components/browsing_data/core/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "third_party/re2/src/re2/re2.h"
+
+namespace aerium_site_rules {
+
+namespace {
+
+// Keys in the stored dictionary. Short and stable: this pref is written by
+// the Settings page and read here, and renaming one silently drops the rule.
+constexpr char kPatternKey[] = "pattern";
+constexpr char kListKey[] = "list";
+constexpr char kKeepKey[] = "keep";
+
+constexpr char kListKeep[] = "keep";
+constexpr char kListSession[] = "session";
+constexpr char kListReset[] = "reset";
+
+// The data types a rule can name, in the order the Settings table shows them.
+// Every one is in chrome_browsing_data_remover::FILTERABLE_DATA_TYPES, which
+// is not a detail: handing an unfilterable type to a filtered removal trips a
+// CHECK in ChromeBrowsingDataRemoverDelegate::RemoveEmbedderData() and takes
+// release builds down with it.
+struct TypeEntry {
+  const char* key;
+  uint64_t type;
+};
+
+constexpr TypeEntry kTypes[] = {
+    {"cookies", content::BrowsingDataRemover::DATA_TYPE_COOKIES},
+    {"cache", content::BrowsingDataRemover::DATA_TYPE_CACHE},
+    {"filesystems", content::BrowsingDataRemover::DATA_TYPE_FILE_SYSTEMS},
+    {"indexeddb", content::BrowsingDataRemover::DATA_TYPE_INDEXED_DB},
+    {"localstorage", content::BrowsingDataRemover::DATA_TYPE_LOCAL_STORAGE},
+    {"serviceworkers", content::BrowsingDataRemover::DATA_TYPE_SERVICE_WORKERS},
+};
+
+// Everything a rule is allowed to keep, which is what the three legacy keep
+// lists meant when they held a bare hostname.
+uint64_t AllTypes() {
+  uint64_t mask = 0;
+  for (const TypeEntry& entry : kTypes) {
+    mask |= entry.type;
+  }
+  return mask;
+}
+
+// A pattern written as /.../ is a regular expression, the same spelling
+// Cookie AutoDelete uses. Anything else is a host expression.
+bool IsRegexPattern(std::string_view pattern) {
+  return pattern.size() >= 2 && pattern.front() == '/' && pattern.back() == '/';
+}
+
+// Strips the sugar people paste in - a leading "*." or "[*.]", a scheme, a
+// trailing slash - and lower-cases what is left. The result is compared
+// against a host, so it has to be a host.
+std::string NormalizeHostExpression(std::string_view pattern) {
+  std::string host = base::ToLowerASCII(base::TrimWhitespaceASCII(
+      pattern, base::TRIM_ALL));
+  if (base::StartsWith(host, "[*.]")) {
+    host = host.substr(4);
+  } else if (base::StartsWith(host, "*.")) {
+    host = host.substr(2);
+  }
+  const size_t scheme_end = host.find("://");
+  if (scheme_end != std::string::npos) {
+    host = host.substr(scheme_end + 3);
+  }
+  const size_t slash = host.find('/');
+  if (slash != std::string::npos) {
+    host = host.substr(0, slash);
+  }
+  while (!host.empty() && host.back() == '.') {
+    host.pop_back();
+  }
+  return host;
+}
+
+bool ParseListType(const std::string* value, ListType* out) {
+  if (!value) {
+    return false;
+  }
+  if (*value == kListKeep) {
+    *out = ListType::kKeep;
+  } else if (*value == kListSession) {
+    *out = ListType::kSession;
+  } else if (*value == kListReset) {
+    *out = ListType::kReset;
+  } else {
+    return false;
+  }
+  return true;
+}
+
+// Host expressions match the host itself and anything under it. Done by
+// suffix rather than by folding both sides to their registrable domain,
+// because a rule naming one subdomain has to be able to mean that subdomain -
+// eTLD+1 folding turned "mail.example.com" into "example.com" and quietly
+// widened the rule to cover the whole site.
+bool HostMatchesSuffix(const std::string& host, const std::string& suffix) {
+  if (suffix.empty()) {
+    return false;
+  }
+  if (host == suffix) {
+    return true;
+  }
+  return host.size() > suffix.size() &&
+         base::EndsWith(host, suffix) &&
+         host[host.size() - suffix.size() - 1] == '.';
+}
+
+}  // namespace
+
+Rule::Rule() = default;
+Rule::Rule(Rule&&) = default;
+Rule& Rule::operator=(Rule&&) = default;
+Rule::~Rule() = default;
+
+std::vector<Rule> ReadRules(PrefService* prefs) {
+  std::vector<Rule> rules;
+  if (!prefs) {
+    return rules;
+  }
+  for (const base::Value& entry :
+       prefs->GetList(browsing_data::prefs::kAeriumSiteRules)) {
+    const base::DictValue* dict = entry.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    const std::string* pattern = dict->FindString(kPatternKey);
+    if (!pattern || pattern->empty()) {
+      continue;
+    }
+    Rule rule;
+    if (!ParseListType(dict->FindString(kListKey), &rule.list)) {
+      continue;
+    }
+    rule.pattern = *pattern;
+    if (IsRegexPattern(*pattern)) {
+      const std::string body = pattern->substr(1, pattern->size() - 2);
+      RE2::Options options;
+      options.set_log_errors(false);
+      options.set_case_sensitive(false);
+      auto compiled = std::make_unique<RE2>(body, options);
+      if (!compiled->ok()) {
+        // A pattern that does not compile matches nothing, so dropping it is
+        // the same behaviour with less to go wrong. The Settings page refuses
+        // to store one, so this only catches a hand-edited Preferences file.
+        continue;
+      }
+      rule.regex = std::move(compiled);
+    } else {
+      rule.host_suffix = NormalizeHostExpression(*pattern);
+      if (rule.host_suffix.empty()) {
+        continue;
+      }
+    }
+    if (const base::DictValue* keep = dict->FindDict(kKeepKey)) {
+      for (const TypeEntry& type : kTypes) {
+        if (keep->FindBool(type.key).value_or(false)) {
+          rule.keep_mask |= type.type;
+        }
+      }
+    }
+    rules.push_back(std::move(rule));
+  }
+  return rules;
+}
+
+const Rule* FindRule(const std::vector<Rule>& rules, const std::string& host) {
+  if (host.empty()) {
+    return nullptr;
+  }
+  const std::string lowered = base::ToLowerASCII(host);
+  for (const Rule& rule : rules) {
+    if (rule.regex) {
+      if (RE2::PartialMatch(lowered, *rule.regex)) {
+        return &rule;
+      }
+    } else if (HostMatchesSuffix(lowered, rule.host_suffix)) {
+      return &rule;
+    }
+  }
+  return nullptr;
+}
+
+bool HasRegexRule(const std::vector<Rule>& rules) {
+  for (const Rule& rule : rules) {
+    if (rule.regex) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void MigrateLegacyLists(PrefService* prefs) {
+  if (!prefs ||
+      prefs->GetBoolean(browsing_data::prefs::kAeriumSiteRulesMigrated)) {
+    return;
+  }
+  const uint64_t all = AllTypes();
+  const struct {
+    const char* pref;
+    const char* list;
+    bool keep_everything;
+  } sources[] = {
+      {browsing_data::prefs::kAeriumClearOnExitExcludedSites, kListKeep, true},
+      {browsing_data::prefs::kAeriumSessionOnlySites, kListSession, true},
+      {browsing_data::prefs::kAeriumEphemeralSites, kListReset, false},
+  };
+  {
+    // Scoped so the list is committed - and its change notification sent -
+    // before the flag below says the migration happened. Flipping the flag
+    // first would leave a window in which a reader sees "migrated" and an
+    // empty table.
+    ScopedListPrefUpdate update(prefs, browsing_data::prefs::kAeriumSiteRules);
+    for (const auto& source : sources) {
+      for (const base::Value& entry : prefs->GetList(source.pref)) {
+        if (!entry.is_string() || entry.GetString().empty()) {
+          continue;
+        }
+        base::DictValue keep;
+        for (const TypeEntry& type : kTypes) {
+          keep.Set(type.key, source.keep_everything && (all & type.type) != 0);
+        }
+        base::DictValue rule;
+        rule.Set(kPatternKey, entry.GetString());
+        rule.Set(kListKey, source.list);
+        rule.Set(kKeepKey, std::move(keep));
+        update->Append(std::move(rule));
+      }
+    }
+  }
+  prefs->SetBoolean(browsing_data::prefs::kAeriumSiteRulesMigrated, true);
+}
+
+}  // namespace aerium_site_rules
