+#ifndef CHROME_BROWSER_BROWSING_DATA_AERIUM_SITE_RULES_H_
+#define CHROME_BROWSER_BROWSING_DATA_AERIUM_SITE_RULES_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "content/public/browser/browsing_data_remover.h"
+
+class PrefService;
+class PrefRegistrySimple;
+
+namespace re2 {
+class RE2;
+}
+
+namespace aerium_site_rules {
+
+// Aerium: one row of the site rules table.
+//
+// Cookie AutoDelete's model, which is what people coming to this feature
+// expect: a list of expressions, each saying which list a site belongs to and
+// which kinds of data survive a cleanup. Three earlier prefs each held one
+// list of bare hostnames; this replaces all three, because "keep this site",
+// "keep it until I quit" and "reset it on tab close" are the same statement
+// with a different answer, and holding them apart meant a site could sit in
+// two of them saying contradictory things.
+enum class ListType {
+  // Never cleared automatically.
+  kKeep,
+  // Kept while the browser runs, cleared at shutdown. Cookie AutoDelete calls
+  // this the greylist.
+  kSession,
+  // Cleared as soon as the site's last tab closes.
+  kReset,
+};
+
+struct Rule {
+  Rule();
+  Rule(const Rule&) = delete;
+  Rule& operator=(const Rule&) = delete;
+  Rule(Rule&&);
+  Rule& operator=(Rule&&);
+  ~Rule();
+
+  // As the user typed it, so the UI can show it back unchanged.
+  std::string pattern;
+
+  // Compiled form of `pattern` when it was written as /.../, null otherwise.
+  // Held rather than recompiled per host: a rule is tested once per closing
+  // tab, but the rule set is parsed once per test.
+  std::unique_ptr<re2::RE2> regex;
+
+  // Lower-cased host expression when `regex` is null. Matches the host itself
+  // and anything under it, so "example.com" covers "www.example.com" - which
+  // is what people mean by a site, and what the *.example.com in Cookie
+  // AutoDelete's own examples means.
+  std::string host_suffix;
+
+  ListType list = ListType::kReset;
+
+  // Data types this rule keeps. A cleanup deletes what is NOT listed here.
+  // Meaningful on every list type: on kKeep and kSession they say what
+  // survives, on kReset they say what a reset spares.
+  uint64_t keep_mask = 0;
+};
+
+// Parses the rules pref. Entries that are not dictionaries, carry an empty
+// pattern, or name an unknown list are dropped rather than defaulted: a
+// malformed rule that quietly became "keep everything" would be a data leak
+// and one that became "reset everything" would be data loss, and the pref is
+// reachable through settingsPrivate and by hand-editing Preferences.
+std::vector<Rule> ReadRules(PrefService* prefs);
+
+// The first rule matching `host`, or nullptr. First rather than most
+// specific, so the order shown in Settings is the order that decides - the
+// user can see why a site behaved the way it did by reading down the list.
+const Rule* FindRule(const std::vector<Rule>& rules, const std::string& host);
+
+// True when any rule is a regular expression. Callers that can only build an
+// explicit origin filter use this to decide whether they must enumerate the
+// origins holding data before they can honour the rules.
+bool HasRegexRule(const std::vector<Rule>& rules);
+
+// Folds the three original list prefs into the rules pref, once. Runs before
+// any rule is read, so an upgraded profile behaves on its first launch exactly
+// as it did on its last: keep and session entries keep everything, reset
+// entries keep nothing, which is what those three lists meant.
+void MigrateLegacyLists(PrefService* prefs);
+
+}  // namespace aerium_site_rules
+
+#endif  // CHROME_BROWSER_BROWSING_DATA_AERIUM_SITE_RULES_H_
