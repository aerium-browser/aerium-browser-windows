+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-site-rules' is the site rules table: one row per expression,
+ * saying which list the site is on and which kinds of data survive a cleanup.
+ *
+ * It replaces three separate lists - never delete, keep until I quit, reset on
+ * tab close - which were the same statement with a different answer and were
+ * held apart only because each arrived in its own patch. Holding them apart
+ * let a site sit in two of them saying contradictory things, and it meant the
+ * greylist had no UI at all because nobody had written a third copy of the
+ * same element.
+ *
+ * Storage is one list pref of dictionaries. settingsPrivate exposes list prefs
+ * as PrefType.LIST and PrefsUtil::SetPref() accepts a LIST, so the whole array
+ * is written back on every edit rather than appended to: PrefsMixin offers
+ * appendPrefListItem()/deletePrefListItem() but nothing that updates an item
+ * in place, and toggling a checkbox is an update.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_checkbox/cr_checkbox.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import 'chrome://resources/cr_elements/icons.html.js';
+import 'chrome://resources/cr_elements/md_select.css.js';
+import '../settings_shared.css.js';
+
+import type {CrButtonElement} from 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import type {CrCheckboxElement} from 'chrome://resources/cr_elements/cr_checkbox/cr_checkbox.js';
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import type {PrefsMixinInterface} from '/shared/settings/prefs/prefs_mixin.js';
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {loadTimeData} from '../i18n_setup.js';
+
+import {getTemplate} from './site_rules.html.js';
+
+export const SITE_RULES_PREF: string = 'browser.clear_data.aerium_site_rules';
+
+/**
+ * The data types a rule can keep, in the order the table shows them. The keys
+ * are the ones aerium_site_rules.cc reads; renaming one here drops the flag
+ * silently on the browser side, which is why they are written out once and
+ * used for both storage and rendering.
+ */
+const KEEP_TYPES: Array<{key: string, stringName: string}> = [
+  {key: 'cookies', stringName: 'siteRulesKeepCookies'},
+  {key: 'cache', stringName: 'siteRulesKeepCache'},
+  {key: 'filesystems', stringName: 'siteRulesKeepFileSystems'},
+  {key: 'indexeddb', stringName: 'siteRulesKeepIndexedDb'},
+  {key: 'localstorage', stringName: 'siteRulesKeepLocalStorage'},
+  {key: 'serviceworkers', stringName: 'siteRulesKeepServiceWorkers'},
+];
+
+const LIST_TYPES: string[] = ['keep', 'session', 'reset'];
+
+/** One rule as it is stored in the pref. */
+interface StoredRule {
+  pattern: string;
+  list: string;
+  keep: {[key: string]: boolean};
+}
+
+/** One checkbox in a row. */
+interface KeepView {
+  key: string;
+  label: string;
+  checked: boolean;
+}
+
+/** One row as the template renders it. */
+interface RuleView {
+  pattern: string;
+  list: string;
+  keep: KeepView[];
+}
+
+export interface SiteRulesElement {
+  $: {
+    addButton: CrButtonElement,
+    addDialog: CrDialogElement,
+    addRuleButton: CrButtonElement,
+    patternInput: CrInputElement,
+  };
+}
+
+type Constructor<T> = new (...args: any[]) => T;
+const SiteRulesElementBase = PrefsMixin(PolymerElement) as
+    Constructor<PrefsMixinInterface&PolymerElement>;
+
+export class SiteRulesElement extends SiteRulesElementBase {
+  static get is() {
+    return 'settings-site-rules';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      rules_: {
+        type: Array,
+        value: () => [],
+      },
+
+      newPattern_: {
+        type: String,
+        value: '',
+      },
+
+      newList_: {
+        type: String,
+        value: 'keep',
+      },
+
+      addDisabled_: {
+        type: Boolean,
+        value: true,
+      },
+
+      inputInvalid_: {
+        type: Boolean,
+        value: false,
+      },
+
+      errorMessage_: {
+        type: String,
