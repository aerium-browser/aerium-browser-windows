+// Aerium: whether the daily release check has something to report. Both prefs
+// are written together and both are cleared when this build turns out to be the
+// newest, so either being empty means there is nothing to offer. Spelled out
+// rather than read from chrome/browser/aerium/aerium_update_checker.h, which
+// drags the network service into anything that includes it - the same reason
+// prefs_util.cc lists them as literals.
+bool AeriumUpdateAvailable(Profile* profile) {
+  const PrefService* prefs = profile->GetPrefs();
+  return !prefs->GetString("aerium.update.latest_version").empty() &&
+         !prefs->GetString("aerium.update.latest_url").empty();
+}
