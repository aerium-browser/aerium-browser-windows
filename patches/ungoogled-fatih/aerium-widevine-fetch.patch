@@ -48,6 +49,7 @@
 #include "components/on_device_translation/buildflags/buildflags.h"
 #include "components/optimization_guide/core/model_execution/model_execution_prefs.h"
 #include "components/optimization_guide/core/model_execution/model_execution_util.h"
+#include "components/prefs/pref_change_registrar.h"
 #include "components/prefs/pref_service.h"
 #include "components/safe_browsing/core/common/features.h"
 #include "device/vr/buildflags/buildflags.h"
@@ -134,11 +136,80 @@ void DeleteOldComponents(const base::FilePath& user_data_dir) {
   }
 }
 
+#if BUILDFLAG(ENABLE_WIDEVINE_CDM_COMPONENT)
+// Aerium: the Settings > Media switch, in Local State. See browser_prefs.cc.
+constexpr char kAeriumDrmEnabledPref[] = "aerium.drm_enabled";
+
+bool AeriumDrmEnabled() {
+  PrefService* const local_state = g_browser_process->local_state();
+  return local_state && local_state->GetBoolean(kAeriumDrmEnabledPref);
+}
+
+// Aerium: run when the switch is flipped, so that turning DRM on starts the
+// download in this session rather than one launch later.
+//
+// The unregister loop is not tidiness, it is the whole reason this is safe.
+// ChromeConfigurator::UpdateUrl() is about to start returning the real update
+// service, and it returns it for whatever is registered - so at startup the
+// gate below registers Widevine and nothing else. Flipping the switch at
+// runtime arrives too late for that: everything was already registered while
+// DRM was off. Clearing the list first puts this session in the same state a
+// launch with DRM on would have been in.
+//
+// Dropping them costs nothing. component_updater_url_constants.cc is in
+// ungoogled-chromium's domain_substitution.list, so every one of them has
+// spent its whole life pointed at a host that does not resolve: none has ever
+// downloaded a payload, so none has an on-disk copy for its installer to load,
+// so unregistering removes nothing that was doing anything. That was checked
+// rather than assumed - it is why an installer's ComponentReady() never fires
+// in this browser today.
+void AeriumOnDrmPrefChanged() {
+  if (!AeriumDrmEnabled()) {
+    // Turning it off leaves the CDM registered for the rest of this session -
+    // it is already loaded - and takes effect at the next launch.
+    return;
+  }
+  ComponentUpdateService* const cus = g_browser_process->component_updater();
+  if (!cus) {
+    return;
+  }
+  for (const std::string& id : cus->GetComponentIDs()) {
+    cus->UnregisterComponent(id);
+  }
+  RegisterWidevineCdmComponent(cus);
+}
+#endif  // BUILDFLAG(ENABLE_WIDEVINE_CDM_COMPONENT)
+
 }  // namespace
 
 void RegisterComponentsForUpdate() {
   auto* const cus = g_browser_process->component_updater();
 
+#if BUILDFLAG(ENABLE_WIDEVINE_CDM_COMPONENT)
+  // Aerium: watch the switch, so flipping it in Settings takes effect without
+  // a restart. On Windows and Mac that is the whole flow - the installer's
+  // ComponentReady() calls CdmRegistry::RegisterCdm() directly. On Linux the
+  // CDM has to be registered before the zygote sandbox closes, so the download
+  // lands in this session and one restart picks it up; without this it took
+  // two, one to start the download and one to use it.
+  static base::NoDestructor<PrefChangeRegistrar> aerium_drm_registrar;
+  if (aerium_drm_registrar->IsEmpty()) {
+    if (PrefService* const local_state = g_browser_process->local_state()) {
+      aerium_drm_registrar->Init(local_state);
+      aerium_drm_registrar->Add(kAeriumDrmEnabledPref,
+                                base::BindRepeating(&AeriumOnDrmPrefChanged));
+    }
+  }
+
+  // With DRM on, the Widevine CDM component is the ONLY component registered.
+  // See AeriumOnDrmPrefChanged() above for why that narrowness is required and
+  // why it costs nothing.
+  if (AeriumDrmEnabled()) {
+    RegisterWidevineCdmComponent(cus);
+    return;
+  }
+#endif  // BUILDFLAG(ENABLE_WIDEVINE_CDM_COMPONENT)
+
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
   RegisterRecoveryImprovedComponent(cus, g_browser_process->local_state());
 #endif  // BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
